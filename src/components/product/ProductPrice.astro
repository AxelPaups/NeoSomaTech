---
import { renderPriceHtml, type PriceLabels } from '../../lib/productPage';
import { normalizeCurrency, type MoneyCtx } from '../../lib/money';

interface Props {
	prix?: string | number | null;
	isPromo?: boolean;
	promoPrice?: string | number | null;
	devise?: string | null;
	ctx: MoneyCtx;
	labels?: PriceLabels;
}

const { prix = '', isPromo = false, promoPrice = '', devise = 'EUR', ctx, labels } = Astro.props;
const html = renderPriceHtml(String(prix ?? ''), isPromo, String(promoPrice ?? ''), {
	devise: normalizeCurrency(devise),
	ctx,
	note: true,
	labels,
});
---

<div set:html={html} />
