---
// Règle graduée fixe (bord gauche, desktop) : le repère indique la progression de lecture en cm.
---

<div class="ruler" aria-hidden="true">
	<div class="ruler-marker" id="rulerMarker">
		<span id="rulerValue">0 cm</span>
	</div>
</div>

<script>
	const marker = document.getElementById("rulerMarker");
	const value = document.getElementById("rulerValue");
	if (marker && value) {
		let ticking = false;
		const update = () => {
			const max = document.documentElement.scrollHeight - window.innerHeight;
			const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
			marker.style.top = `${p * 100}%`;
			value.textContent = `${Math.round(p * 190)} cm`;
			ticking = false;
		};
		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true }
		);
		window.addEventListener("resize", update);
		update();
	}
</script>

<style>
	.ruler {
		position: fixed;
		top: 0;
		bottom: 0;
		left: 0;
		width: 22px;
		z-index: 90;
		display: none;
		pointer-events: none;
		border-right: 1px solid var(--rule-strong);
		background-color: var(--paper);
		background-image:
			repeating-linear-gradient(to bottom, var(--ink) 0 1px, transparent 1px 8px),
			repeating-linear-gradient(to bottom, var(--ink) 0 1px, transparent 1px 40px);
		background-size: 6px 100%, 14px 100%;
		background-repeat: no-repeat;
		background-position: right top, right top;
	}
	.ruler-marker {
		position: absolute;
		left: 0;
		right: -1px;
		height: 0;
		border-top: 2px solid var(--vermilion);
		transition: top 0.08s linear;
	}
	.ruler-marker span {
		position: absolute;
		left: 26px;
		top: -11px;
		font-family: var(--f-mono);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--paper);
		background: var(--vermilion);
		padding: 2px 6px;
		white-space: nowrap;
	}
	.ruler-marker::before {
		content: "";
		position: absolute;
		right: -1px;
		top: -5px;
		border-left: 8px solid var(--vermilion);
		border-top: 4px solid transparent;
		border-bottom: 4px solid transparent;
		transform: translateX(8px);
	}
	@media (min-width: 1240px) {
		.ruler {
			display: block;
		}
		:global(body[data-theme="planche"]) {
			padding-left: 22px;
		}
	}
</style>
