---
// src/components/Header.astro
import { useTranslations, path, locales, localeMeta, type Locale } from '../i18n';

interface Props {
    locale?: Locale;
    /** Adresse de la page courante dans chaque langue disponible */
    alternates?: Partial<Record<Locale, string>>;
}

const { locale = 'fr', alternates = {} } = Astro.props;
const t = useTranslations(locale);

const navLinks = [
    { href: path(locale, 'home'), label: t.nav.home },
    { href: path(locale, 'articles'), label: t.nav.articles },
    { href: path(locale, 'shop'), label: t.nav.shop },
    { href: path(locale, 'compare'), label: t.nav.compare },
    { href: path(locale, 'advisor'), label: t.nav.advisor },
    { href: path(locale, 'about'), label: t.nav.about },
    { href: path(locale, 'contact'), label: t.nav.contact },
];

const homePath = path(locale, 'home');
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
    href === homePath
        ? currentPath === href || currentPath === href.replace(/\/$/, '')
        : currentPath.startsWith(href);

// Lien vers l'autre langue : la même page si elle existe, sinon l'accueil de cette langue
const switchLinks = locales
    .filter((l) => l !== locale)
    .map((l) => ({ locale: l, href: alternates[l] ?? path(l, 'home'), label: localeMeta[l].short, title: `${t.lang.switchTo} ${t.lang[l]}` }));
---

<header class="header">
    <div class="header-inner">
        <a href={homePath} class="logo" aria-label={t.nav.homeAria}>
            <img src="/favicon.png" alt="NST Logo" class="logo-img" />
            NeoSomaTech
        </a>
        <nav class="nav">
            {navLinks.map(link => (
                <a
                    href={link.href}
                    class:list={["nav-link", { active: isActive(link.href) }]}
                >
                    {link.label}
                </a>
            ))}
        </nav>
        <div class="header-tools">
            {switchLinks.map((l) => (
                <a class="lang-switch" href={l.href} hreflang={localeMeta[l.locale].hreflang} lang={l.locale} title={l.title}>{l.label}</a>
            ))}
            <div class="fx-toggle" role="group" aria-label={t.money.label}>
                <button type="button" data-fx-set="EUR" aria-pressed="true" title={t.money.showEur}>€</button>
                <button type="button" data-fx-set="USD" aria-pressed="false" title={t.money.showUsd}>$</button>
            </div>
        </div>
        <span class="header-meta">{t.nav.plateLabel} &middot; {new Date().getFullYear()}</span>
        <button class="menu-toggle" id="menuToggle" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </div>
    <nav class="mobile-nav" id="mobileNav">
        {navLinks.map(link => (
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
        ))}
        {switchLinks.map((l) => (
            <a href={l.href} class="mobile-nav-link" hreflang={localeMeta[l.locale].hreflang} lang={l.locale}>{t.lang[l.locale]}</a>
        ))}
    </nav>
</header>

<style>
    .header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15, 15, 30, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(99, 102, 241, 0.2);
    }
    .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
    }
    @media (max-width: 700px) {
        .header-inner {
            padding: 0.75rem 1rem;
            gap: 1rem;
        }
    }
    .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.4rem;
        font-weight: 800;
        color: #fff;
        text-decoration: none;
        letter-spacing: -0.5px;
        transition: opacity 0.2s;
    }
    .logo:hover { opacity: 0.85; }
    .logo-img {
        width: 32px;
        height: 32px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }
    .nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .nav-link {
        color: #a5b4fc;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        padding: 0.5rem 0.85rem;
        border-radius: 8px;
        transition: background 0.2s, color 0.2s;
    }
    .nav-link:hover, .nav-link.active {
        background: rgba(99, 102, 241, 0.15);
        color: #fff;
    }
    .nav-link.active {
        color: #818cf8;
    }
    /* Menu burger mobile */
    .menu-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
    }
    .menu-toggle span {
        display: block;
        width: 24px;
        height: 2px;
        background: #a5b4fc;
        border-radius: 2px;
        transition: transform 0.2s;
    }
    .mobile-nav {
        display: none;
        flex-direction: column;
        padding: 0.75rem 1.5rem 1rem;
        border-top: 1px solid rgba(99, 102, 241, 0.15);
    }
    .mobile-nav.open { display: flex; }
    .mobile-nav-link {
        color: #a5b4fc;
        text-decoration: none;
        font-weight: 500;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-size: 1rem;
        transition: color 0.2s;
    }
    .mobile-nav-link:last-child { border-bottom: none; }
    .mobile-nav-link:hover { color: #fff; }

    @media (max-width: 700px) {
        .nav { display: none; }
        .menu-toggle { display: flex; }
    }

    /* ── Thème "planche" ── */
    .header-meta { display: none; }
    .header-tools { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; }
    .lang-switch {
        font-family: var(--f-mono);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        color: var(--ink);
        text-decoration: none;
        padding: 0.42rem 0.55rem;
        border: 1px solid var(--rule);
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .lang-switch:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .fx-toggle {
        display: inline-flex;
        border: 1px solid var(--ink);
        flex-shrink: 0;
    }
    .fx-toggle button {
        min-width: 2.3rem;
        padding: 0.4rem 0.6rem;
        font-family: var(--f-mono);
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--ink);
        background: transparent;
        border: none;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
    }
    .fx-toggle button + button { border-left: 1px solid var(--ink); }
    .fx-toggle button:hover { background: var(--paper-2); }
    .fx-toggle button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }


    :global(body[data-theme="planche"]) .header {
        background: rgba(242, 236, 223, 0.92);
        border-bottom: 1px solid var(--ink);
    }
    :global(body[data-theme="planche"]) .header-inner {
        max-width: 1440px;
    }
    :global(body[data-theme="planche"]) .logo {
        color: var(--ink);
        font-family: var(--f-display);
        font-size: 1.55rem;
        font-weight: 480;
        font-variation-settings: "opsz" 72;
        letter-spacing: -0.03em;
    }
    :global(body[data-theme="planche"]) .logo-img {
        filter: none;
        width: 30px;
        height: 30px;
    }
    :global(body[data-theme="planche"]) .nav {
        gap: 0.25rem;
        counter-reset: nav;
    }
    :global(body[data-theme="planche"]) .nav-link {
        font-family: var(--f-mono);
        font-size: 0.74rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink);
        border-radius: 0;
        padding: 0.55rem 0.8rem;
        counter-increment: nav;
        position: relative;
    }
    :global(body[data-theme="planche"]) .nav-link::before {
        content: "0" counter(nav);
        color: var(--vermilion);
        margin-right: 0.45em;
        font-weight: 600;
    }
    :global(body[data-theme="planche"]) .nav-link:hover {
        background: var(--ink);
        color: var(--paper);
    }
    :global(body[data-theme="planche"]) .nav-link.active {
        background: transparent;
        color: var(--ink);
        box-shadow: inset 0 -2px 0 var(--vermilion);
    }
    :global(body[data-theme="planche"]) .nav-link.active:hover {
        background: var(--ink);
        color: var(--paper);
    }
    :global(body[data-theme="planche"]) .header-meta {
        display: block;
        font-family: var(--f-mono);
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
        border: 1px solid var(--rule);
        padding: 0.35rem 0.6rem;
        white-space: nowrap;
    }
    :global(body[data-theme="planche"]) .menu-toggle span {
        background: var(--ink);
        border-radius: 0;
    }
    :global(body[data-theme="planche"]) .mobile-nav {
        border-top: 1px solid var(--rule);
    }
    :global(body[data-theme="planche"]) .mobile-nav-link {
        font-family: var(--f-mono);
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink);
        border-bottom: 1px solid var(--rule);
    }
    :global(body[data-theme="planche"]) .mobile-nav-link:hover {
        color: var(--vermilion);
    }
    @media (max-width: 1100px) {
        :global(body[data-theme="planche"]) .header-meta { display: none; }
    }
</style>

<script>
    const toggle = document.getElementById('menuToggle');
    const nav = document.getElementById('mobileNav');
    toggle?.addEventListener('click', () => nav?.classList.toggle('open'));
</script>