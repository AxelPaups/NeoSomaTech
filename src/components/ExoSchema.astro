---
// Planche anatomique : silhouette + exosquelette au trait, légendes numérotées.
// La moitié gauche est dessinée une fois puis dupliquée en miroir autour de l'axe x=200.

type Shape = { t: "path" | "circle"; d?: string; cx?: number; cy?: number; r?: number; cls?: string };

const body: string[] = [
	"M192,94 L192,110",
	"M192,110 C172,112 152,116 138,126",
	"M138,126 C128,152 120,190 115,222 L105,302",
	"M151,131 C143,162 138,192 134,222 L122,298",
	"M105,302 C101,318 106,326 113,326 C120,326 123,316 122,298",
	"M151,131 C155,182 159,222 157,252 C155,272 148,286 143,302",
	"M143,302 C152,322 176,330 200,332",
	"M143,302 C139,362 137,402 139,440 C131,470 131,505 137,540",
	"M200,332 C186,382 173,412 169,440 C165,470 167,505 164,540",
	"M137,540 C133,548 128,552 124,558 L170,558 C168,550 165,545 164,540",
];

const parts: { key: string; shapes: Shape[] }[] = [
	{
		key: "belt",
		shapes: [
			{ t: "path", d: "M174,118 L164,262", cls: "line" },
			{ t: "path", d: "M140,262 H200 V282 H140 Z", cls: "solid" },
		],
	},
	{
		key: "hip",
		shapes: [
			{ t: "circle", cx: 140, cy: 298, r: 15, cls: "solid" },
			{ t: "circle", cx: 140, cy: 298, r: 6, cls: "core" },
			{ t: "circle", cx: 140, cy: 298, r: 19, cls: "gear" },
		],
	},
	{
		key: "thigh",
		shapes: [
			{ t: "path", d: "M138,314 L136,428", cls: "line" },
			{ t: "path", d: "M132,352 H192 V362 H132 Z", cls: "solid" },
			{ t: "path", d: "M133,394 H182 V404 H133 Z", cls: "solid" },
		],
	},
	{
		key: "knee",
		shapes: [
			{ t: "circle", cx: 140, cy: 442, r: 13, cls: "solid" },
			{ t: "circle", cx: 140, cy: 442, r: 5, cls: "core" },
			{ t: "circle", cx: 140, cy: 442, r: 17, cls: "gear" },
		],
	},
	{
		key: "ankle",
		shapes: [
			{ t: "path", d: "M137,456 L135,532", cls: "line" },
			{ t: "path", d: "M128,488 H172 V497 H128 Z", cls: "solid" },
			{ t: "circle", cx: 137, cy: 540, r: 7, cls: "solid" },
			{ t: "path", d: "M128,550 H170", cls: "line" },
		],
	},
];

const callouts = [
	{ n: 1, key: "belt", x: 262, y: 272, label: "Ceinture lombaire" },
	{ n: 2, key: "hip", x: 282, y: 298, label: "Moteur de hanche" },
	{ n: 3, key: "thigh", x: 270, y: 357, label: "Tuteur de cuisse" },
	{ n: 4, key: "knee", x: 278, y: 442, label: "Genou articulé" },
	{ n: 5, key: "ankle", x: 274, y: 540, label: "Appui cheville" },
];

const halves = [
	{ id: "left", transform: undefined },
	{ id: "right", transform: "translate(400 0) scale(-1 1)" },
];
---

<svg
	class="exo"
	viewBox="40 0 480 590"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label="Schéma d'un exosquelette des membres inférieurs, avec ceinture lombaire, moteur de hanche, tuteur de cuisse, genou articulé et appui cheville"
>
	<!-- axe de symétrie -->
	<path class="axis fade" style="--d:0.2s" d="M200,8 V584"></path>

	<!-- silhouette -->
	<g class="body">
		<ellipse class="draw" style="--d:0s" pathLength="1" cx="200" cy="62" rx="27" ry="33"></ellipse>
		{
			halves.map((h) => (
				<g transform={h.transform}>
					{body.map((d, i) => (
						<path class="draw" style={`--d:${0.1 + i * 0.09}s`} pathLength="1" d={d} />
					))}
				</g>
			))
		}
	</g>

	<!-- exosquelette -->
	<g class="exo-parts">
		{
			parts.map((p, pi) => (
				<g class:list={["part", `part--${p.key}`]}>
					{halves.map((h) => (
						<g transform={h.transform}>
							{p.shapes.map((s, si) =>
								s.t === "path" ? (
									<path
										class:list={[s.cls, s.cls === "gear" ? "fade" : "draw"]}
										style={`--d:${1 + pi * 0.22 + si * 0.08}s`}
										pathLength={s.cls === "gear" ? undefined : 1}
										d={s.d}
									/>
								) : (
									<circle
										class:list={[s.cls, s.cls === "gear" ? "fade" : "draw"]}
										style={`--d:${1 + pi * 0.22 + si * 0.08}s`}
										pathLength={s.cls === "gear" ? undefined : 1}
										cx={s.cx}
										cy={s.cy}
										r={s.r}
									/>
								),
							)}
						</g>
					))}
				</g>
			))
		}
		<rect class="solid fade" style="--d:1.2s" x="190" y="266" width="20" height="12"></rect>
	</g>

	<!-- cote verticale -->
	<g class="dim fade" style="--d:1.6s">
		<path d="M72,29 V557"></path>
		<path d="M64,29 H80 M64,557 H80"></path>
		<path d="M72,29 l-3,9 h6 z M72,557 l-3,-9 h6 z" class="arrow"></path>
		<path class="ext" d="M84,29 H170 M84,558 H120"></path>
		<text transform="translate(58 300) rotate(-90)" text-anchor="middle">H = 1 750 mm</text>
	</g>

	<!-- légendes -->
	{
		callouts.map((c, i) => (
			<g class:list={["co", `co--${c.key}`, "fade"]} style={`--d:${2 + i * 0.15}s`} tabindex="0">
				<circle class="co-dot" cx={c.x} cy={c.y} r="2.6" />
				<path class="co-line" d={`M${c.x},${c.y} H321`} />
				<circle class="co-badge" cx="330" cy={c.y} r="9.5" />
				<text class="co-num" x="330" y={c.y + 3.6} text-anchor="middle">{c.n}</text>
				<text class="co-text" x="346" y={c.y + 4}>{c.label}</text>
				<rect x={c.x - 6} y={c.y - 12} width={490 - c.x} height="24" fill="transparent" />
			</g>
		))
	}
</svg>

<style>
	.exo {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.axis {
		fill: none;
		stroke: var(--ink-soft);
		stroke-width: 0.8;
		stroke-dasharray: 14 3 2 3;
		opacity: 0.55;
	}

	.body path,
	.body ellipse {
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.55;
	}

	.part {
		--c: var(--ink);
	}
	.part .line {
		fill: none;
		stroke: var(--c);
		stroke-width: 2.6;
		stroke-linecap: square;
	}
	.part .solid {
		fill: var(--paper);
		stroke: var(--c);
		stroke-width: 2.2;
		stroke-linejoin: round;
	}
	.part .core {
		fill: var(--vermilion);
		stroke: none;
	}
	.part .gear {
		fill: none;
		stroke: var(--c);
		stroke-width: 3;
		stroke-dasharray: 2 3.4;
		opacity: 0.7;
	}
	.exo-parts > .solid {
		fill: var(--paper);
		stroke: var(--ink);
		stroke-width: 2;
	}

	.exo:has(.co--belt:hover, .co--belt:focus) .part--belt,
	.exo:has(.co--hip:hover, .co--hip:focus) .part--hip,
	.exo:has(.co--thigh:hover, .co--thigh:focus) .part--thigh,
	.exo:has(.co--knee:hover, .co--knee:focus) .part--knee,
	.exo:has(.co--ankle:hover, .co--ankle:focus) .part--ankle {
		--c: var(--vermilion);
	}

	.dim path {
		fill: none;
		stroke: var(--ink-soft);
		stroke-width: 1;
	}
	.dim .arrow {
		fill: var(--ink-soft);
		stroke: none;
	}
	.dim .ext {
		stroke-dasharray: 3 3;
		opacity: 0.7;
	}
	.dim text {
		font-family: var(--f-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		fill: var(--ink-soft);
		text-transform: uppercase;
	}

	.co {
		outline: none;
		cursor: default;
	}
	.co-dot {
		fill: var(--vermilion);
	}
	.co-line {
		fill: none;
		stroke: var(--vermilion);
		stroke-width: 1;
	}
	.co-badge {
		fill: var(--paper);
		stroke: var(--vermilion);
		stroke-width: 1.4;
		transition: fill 0.2s;
	}
	.co-num {
		font-family: var(--f-mono);
		font-size: 11px;
		font-weight: 600;
		fill: var(--vermilion);
		transition: fill 0.2s;
	}
	.co-text {
		font-family: var(--f-mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.02em;
		fill: var(--ink);
		transition: fill 0.2s;
	}
	.co:hover .co-badge,
	.co:focus .co-badge {
		fill: var(--vermilion);
	}
	.co:hover .co-num,
	.co:focus .co-num {
		fill: var(--paper);
	}
	.co:hover .co-text,
	.co:focus .co-text {
		fill: var(--vermilion);
	}

	@media (max-width: 560px) {
		.co-text {
			font-size: 14px;
		}
		.co-num {
			font-size: 12px;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.draw {
			stroke-dasharray: 1;
			stroke-dashoffset: 1;
			animation: draw 1.5s cubic-bezier(0.6, 0.05, 0.2, 1) forwards;
			animation-delay: var(--d, 0s);
		}
		.fade {
			opacity: 0;
			animation: fade-in 0.7s ease forwards;
			animation-delay: var(--d, 0s);
		}
	}
	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}
	@keyframes fade-in {
		to {
			opacity: 1;
		}
	}
</style>
