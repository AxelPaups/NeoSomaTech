---
import BrandView from '../../../views/BrandView.astro';
import { loadBrandPage } from '../../../lib/brandPage';

const brandSlug = Astro.params.marque as string;
const page = await loadBrandPage('en', brandSlug);
if (page.redirect) return Astro.redirect(page.redirect, 302);
---

<BrandView locale="en" brandSlug={brandSlug} brandName={page.brandName} produits={page.produits} articlesLies={page.articlesLies ?? []} errorMessage={page.errorMessage} alternates={page.alternates} />
