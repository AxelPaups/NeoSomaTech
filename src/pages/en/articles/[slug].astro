---
import ArticleView from '../../../views/ArticleView.astro';
import { loadArticlePage } from '../../../lib/articlePage';

const page = await loadArticlePage('en', Astro.params.slug);
if ('redirect' in page && page.redirect) return Astro.redirect(page.redirect, page.status);
if (page.notFound) return Astro.redirect('/en/404');
// Article introuvable ou en erreur : vrai 404 (et noindex) plutôt qu'une page d'erreur servie en 200.
if (!page.article || page.errorMessage) Astro.response.status = 404;
---

<ArticleView locale="en" article={page.article} productsForLinking={page.productsForLinking ?? []} faqs={page.faqs ?? []} linkedQuestions={page.linkedQuestions ?? []} errorMessage={page.errorMessage ?? null} alternates={page.alternates ?? {}} />
