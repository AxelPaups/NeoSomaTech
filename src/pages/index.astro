---
import Layout from "../layouts/Layout.astro";
import { fetchDirectus, fetchPageSEO, slugifyBrand } from "../lib/directus";
import ExoSchema from "../components/ExoSchema.astro";

let produits: any[] = [];
let articles: any[] = [];
let marques: string[] = [];
const brandCounts: Record<string, number> = {};
let errorMessage: string | null = null;

try {
	const [produitsData, articlesData, marquesData] = await Promise.all([
		fetchDirectus(
			"/items/Produits?limit=3&fields=id,Nom_du_produit,prix,descripton_simple,slug,image,promo,prix_promo",
		),
		fetchDirectus(
			"/items/Articles?limit=3&sort=-date_publication&fields=id,titre,slug,description_seo,date_publication,auteur,image_principale",
		),
		fetchDirectus("/items/Produits?fields=marque&limit=100"),
	]);
	produits = produitsData;
	articles = (articlesData || []).filter((a: any) => a && a.slug);
	for (const p of marquesData ?? []) {
		if (p.marque) brandCounts[p.marque] = (brandCounts[p.marque] ?? 0) + 1;
	}
	marques = Object.keys(brandCounts).sort();

	if (Array.isArray(articles)) {
		articles.sort((a, b) => {
			const dateA = a.date_publication ? new Date(a.date_publication).getTime() : 0;
			const dateB = b.date_publication ? new Date(b.date_publication).getTime() : 0;
			return dateB - dateA;
		});
	}
} catch (error: any) {
	console.error("Erreur Directus:", error);
	errorMessage = error.message;
}

if (marques.length === 0) {
	marques = ["Ski-Mojo", "Hypershell", "Stoko"];
}
const pad = (n: number) => String(n).padStart(2, "0");
const edition = new Intl.DateTimeFormat("fr-FR", { month: "long", year: "numeric" }).format(new Date());

const directusUrl = "https://spirited-squid.pikapod.net";
const formatDate = (date: string) => {
	if (!date) return "";
	try {
		const d = new Date(date);
		if (isNaN(d.getTime())) return date;
		return new Intl.DateTimeFormat("fr-FR", {
			year: "numeric",
			month: "long",
			day: "numeric",
		}).format(d);
	} catch (e) {
		return date;
	}
};

const seo = await fetchPageSEO(
	"accueil",
	"NeoSomaTech - Expert Exosquelettes Médicaux, Sportifs et Industriels",
	"NeoSomaTech, référence francophone des exosquelettes sportifs et médicaux. Découvrez nos sélections, comparatifs et guides d'achat : Ski-Mojo, Hypershell, Stoko. Livraison France."
);

const featuredArticle = articles[0] ?? null;
const sideArticles = articles.slice(1, 3);

const chiffres = [
	{ value: "120+", label: "Exosquelettes analysés" },
	{ value: "15", label: "Marques référencées" },
	{ value: "98%", label: "Lecteurs satisfaits" },
	{ value: "2019", label: "Notre première veille" },
];
---

<Layout
	title={seo.title}
	description={seo.description}
>

	<!-- ===== HERO : PLANCHE I ===== -->
	<section class="hero p-grid-paper">
		<div class="container hero-inner">
			<div class="hero-left">
				<p class="p-label hero-kicker"><b>Planche I</b> &mdash; Référence francophone des exosquelettes</p>
				<h1 class="p-display">
					<span class="hero-line" style="--i:0">Exosquelettes&nbsp;:</span>
					<span class="hero-line" style="--i:1">l'avenir du corps</span>
					<span class="hero-line hero-line--em" style="--i:2">
						<em>commence ici</em>
						<svg class="scribble" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true">
							<path pathLength="1" d="M3,10 C42,3 72,14 112,8 S196,3 232,9 S284,10 297,5" />
						</svg>
					</span>
				</h1>
				<p class="hero-sub">
					Analyses indépendantes, comparatifs détaillés et sélection experte
					des meilleurs exosquelettes médicaux, industriels et sportifs du marché.
				</p>
				<div class="hero-actions">
					<a href="/boutique" class="p-btn p-btn--ink">Voir la boutique <span aria-hidden="true">&rarr;</span></a>
					<a href="/articles" class="p-btn p-btn--line">Lire nos articles</a>
				</div>

				<div class="nomenclature">
					<p class="p-label">Nomenclature des marques</p>
					<ol>
						{marques.slice(0, 6).map((m, i) => (
							<li><a href={`/boutique/${slugifyBrand(m)}`}><i>{pad(i + 1)}</i>{m}</a></li>
						))}
					</ol>
				</div>
			</div>

			<div class="hero-right">
				<div class="plate p-crop" id="plate">
					<span class="plate-tag p-label"><b>Fig. 01</b> &mdash; Membres inférieurs, vue de face</span>
					<div class="plate-fig">
						<ExoSchema />
					</div>
					<div class="crosshair" id="crosshair" aria-hidden="true">
						<i class="ch-x"></i><i class="ch-y"></i><span class="ch-read" id="chRead"></span>
					</div>
					<p class="plate-note p-label">Survolez une légende pour isoler la pièce</p>
				</div>
			</div>
		</div>

		<div class="cartouche">
			<div class="container cartouche-grid">
				<div class="cell"><span class="p-label">Sujet</span><p>Exosquelettes médicaux, sportifs &amp; industriels</p></div>
				<div class="cell"><span class="p-label">Échelle</span><p>1:1 &mdash; à hauteur d'humain</p></div>
				<div class="cell"><span class="p-label">Édition</span><p>{edition}</p></div>
				<div class="cell"><span class="p-label">Planche</span><p>I / VII</p></div>
			</div>
		</div>
	</section>

	<!-- ===== INDEX DES MARQUES : PLANCHE II ===== -->
	<section class="brands" aria-label="Marques référencées">
		<div class="container">
			<div class="section-head reveal">
				<div>
					<p class="p-label"><b>Planche II</b> &mdash; Index</p>
					<h2 class="p-display section-title">Marques <em>suivies</em></h2>
				</div>
				<a href="/boutique" class="link-line">Toute la boutique &rarr;</a>
			</div>
			<ol class="brand-index">
				{marques.map((m, i) => {
					const count = brandCounts[m] ?? 0;
					return (
						<li class="reveal" style={`--delay:${Math.min(i, 6) * 0.05}s`}>
							<a href={`/boutique/${slugifyBrand(m)}`}>
								<span class="bi-n">{pad(i + 1)}</span>
								<span class="bi-name">{m}</span>
								<span class="bi-meta">{count > 0 ? `${count} modèle${count > 1 ? "s" : ""}` : "Voir"}</span>
								<span class="bi-arrow" aria-hidden="true">&nearr;</span>
							</a>
						</li>
					);
				})}
			</ol>
		</div>
	</section>

	<!-- ===== NEO · SOMA · TECH : PLANCHE III ===== -->
	<section class="nst">
		<div class="container">
			<p class="p-label nst-head reveal"><b>Planche III</b> &mdash; Étymologie du nom</p>
			<div class="nst-grid">
				<article class="entry entry--neo reveal">
					<span class="entry-glyph" aria-hidden="true">ν</span>
					<p class="p-label">n° 01 &middot; préfixe &middot; /ne.o/</p>
					<h3 class="p-display">Neo</h3>
					<p class="entry-ety">du grec <em>νέος</em> (<em>néos</em>) &mdash; nouveau</p>
					<p class="entry-def">
						L'innovation constante et le renouveau de nos capacités humaines
						grâce aux technologies de demain.
					</p>
				</article>
				<article class="entry entry--soma reveal" style="--delay:0.1s">
					<span class="entry-glyph" aria-hidden="true">σ</span>
					<p class="p-label">n° 02 &middot; nom &middot; /so.ma/</p>
					<h3 class="p-display">Soma</h3>
					<p class="entry-ety">du grec <em>σῶμα</em> (<em>sôma</em>) &mdash; le corps</p>
					<p class="entry-def">
						L'humain reste au centre. La machine s'adapte à notre biologie,
						jamais l'inverse.
					</p>
				</article>
				<article class="entry entry--tech reveal" style="--delay:0.2s">
					<span class="entry-glyph" aria-hidden="true">τ</span>
					<p class="p-label">n° 03 &middot; nom &middot; /tɛk/</p>
					<h3 class="p-display">Tech</h3>
					<p class="entry-ety">du grec <em>τέχνη</em> (<em>tékhnē</em>) &mdash; l'art, le savoir-faire</p>
					<p class="entry-def">
						Robotique et biomécanique de pointe qui rendent l'augmentation
						physique possible et accessible.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- ===== CHIFFRES ===== -->
	<section class="stats">
		<div class="container stats-grid">
			{chiffres.map((c, i) => (
				<div class="stat reveal" style={`--delay:${i * 0.08}s`}>
					<div class="stat-value">{c.value}</div>
					<div class="p-label">{c.label}</div>
				</div>
			))}
		</div>
	</section>

	<!-- ===== PRODUITS : PLANCHE IV ===== -->
	<section class="produits">
		<div class="container">
			<div class="section-head reveal">
				<div>
					<p class="p-label"><b>Planche IV</b> &mdash; Sélection</p>
					<h2 class="p-display section-title">Nos <em>exosquelettes</em></h2>
				</div>
				<a href="/boutique" class="link-line">Boutique complète &rarr;</a>
			</div>

			{errorMessage ? (
				<div class="error-box"><strong>⚠</strong> {errorMessage}</div>
			) : produits.length === 0 ? (
				<div class="empty-box">Aucun produit pour le moment.</div>
			) : (
				<div class="produits-bento">
					{produits.map((produit, i) => {
						const isPromoValid = produit.promo && produit.prix_promo;
						const displayPromoPrice = isPromoValid
							? (String(produit.prix_promo).includes('€') ? produit.prix_promo : `${produit.prix_promo} €`)
							: null;
						const isFeatured = i === 0;
						return (
							<article
								class:list={["prod", "reveal", { "prod--featured": isFeatured }]}
								style={`--delay:${i * 0.1}s`}
							>
								<div class="prod-media p-grid-paper">
									{produit.image ? (
										<img
											src={`${directusUrl}/assets/${produit.image}?width=${isFeatured ? 900 : 560}&format=webp&quality=82`}
											alt={produit.Nom_du_produit}
											loading="lazy"
											decoding="async"
										/>
									) : (
										<div class="prod-empty p-label">Visuel à venir</div>
									)}
									<span class="prod-fig p-label"><b>Fig. {pad(i + 2)}</b></span>
									<span class:list={["p-stamp", "prod-stamp", { "p-stamp--ink": !isPromoValid }]}>
										{isPromoValid ? "Promo" : "Sélection"}
									</span>
								</div>
								<div class="prod-body">
									<h3 class="p-display"><a href={`/produits/${produit.slug || produit.id}`}>{produit.Nom_du_produit}</a></h3>
									<p class="prod-desc">{produit.descripton_simple}</p>
									<div class="prod-footer">
										<div>
											<div class="p-label">À partir de</div>
											{isPromoValid ? (
												<div class="prod-prices">
													<span class="prod-price prod-price--old">{produit.prix} €</span>
													<span class="prod-price prod-price--promo">{displayPromoPrice}</span>
												</div>
											) : (
												<div class="prod-price">
													{produit.prix ? `${produit.prix} €` : "Sur devis"}
												</div>
											)}
										</div>
										<span class="prod-arrow" aria-hidden="true">&rarr;</span>
									</div>
								</div>
							</article>
						);
					})}
				</div>
			)}
		</div>
	</section>

	<!-- ===== MISSION : PLANCHE V ===== -->
	<section class="mission">
		<div class="container mission-inner">
			<div class="mission-text reveal">
				<p class="p-label"><b>Planche V</b> &mdash; Mission</p>
				<h2 class="p-display section-title">L'exosquelette <em>accessible</em> à tous</h2>
				<p>
					NeoSomaTech est la référence francophone dédiée aux
					<strong>exosquelettes médicaux, industriels et sportifs</strong>.
					Notre équipe analyse, compare et sélectionne les meilleures solutions
					pour augmenter les capacités humaines.
				</p>
				<p>
					Chaque produit est évalué selon des critères stricts de
					<strong>performance, sécurité et ergonomie</strong>.
				</p>
			</div>
			<ol class="piliers reveal" style="--delay:0.1s">
				<li class="pilier">
					<span class="pilier-n">A</span>
					<div class="pilier-content">
						<h3 class="p-display">Expertise technique</h3>
						<p>Analyses par des spécialistes en robotique et biomécanique.</p>
					</div>
					<svg class="pilier-icon" xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18h8"/><path d="M3 22h18"/><path d="m14 22-4-4 4-4"/><path d="m9 14 2 2"/><path d="M12 21a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"/><path d="M18 12.2V7a5 5 0 0 0-5-5"/><path d="M11 5a4 4 0 0 1 4 4v2"/></svg>
				</li>
				<li class="pilier">
					<span class="pilier-n">B</span>
					<div class="pilier-content">
						<h3 class="p-display">Veille permanente</h3>
						<p>Suivi en temps réel des avancées du marché mondial.</p>
					</div>
					<svg class="pilier-icon" xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/></svg>
				</li>
				<li class="pilier">
					<span class="pilier-n">C</span>
					<div class="pilier-content">
						<h3 class="p-display">Accompagnement</h3>
						<p>Conseils personnalisés pour choisir votre exosquelette idéal.</p>
					</div>
					<svg class="pilier-icon" xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
				</li>
			</ol>
		</div>
	</section>

	<!-- ===== ARTICLES : PLANCHE VI ===== -->
	{articles.length > 0 && (
		<section class="articles">
			<div class="container">
				<div class="section-head reveal">
					<div>
						<p class="p-label"><b>Planche VI</b> &mdash; Savoir</p>
						<h2 class="p-display section-title">Derniers <em>articles</em></h2>
					</div>
					<a href="/articles" class="link-line">Tous les articles &rarr;</a>
				</div>

				<div class="articles-layout">
					{featuredArticle && (
						<article class="art-featured reveal">
							{featuredArticle.image_principale ? (
								<a href={`/articles/${featuredArticle.slug}`} class="art-img p-grid-paper" tabindex="-1" aria-hidden="true">
									<img
										src={`${directusUrl}/assets/${featuredArticle.image_principale}?width=900&format=webp&quality=82`}
										alt={featuredArticle.titre}
										loading="lazy"
										decoding="async"
									/>
								</a>
							) : (
								<div class="art-img art-img--empty p-grid-paper"></div>
							)}
							<div class="art-body">
								<div class="art-meta p-label">
									{featuredArticle.date_publication && (
										<time>{formatDate(featuredArticle.date_publication)}</time>
									)}
									{featuredArticle.auteur && (
										<span>&middot; {featuredArticle.auteur === 'Axel Paupier'
											? <a href="/auteur/axel-paupier" rel="author" class="author-link">{featuredArticle.auteur}</a>
											: featuredArticle.auteur}</span>
									)}
								</div>
								<h3 class="p-display">
									<a href={`/articles/${featuredArticle.slug}`}>{featuredArticle.titre}</a>
								</h3>
								{featuredArticle.description_seo && (
									<p class="art-excerpt">{featuredArticle.description_seo}</p>
								)}
								<a href={`/articles/${featuredArticle.slug}`} class="link-line">Lire la suite &rarr;</a>
							</div>
						</article>
					)}

					{sideArticles.length > 0 && (
						<ol class="toc">
							{sideArticles.map((article, i) => (
								<li class="toc-row reveal" style={`--delay:${0.1 + i * 0.08}s`}>
									<span class="toc-n">{pad(i + 2)}</span>
									<div class="toc-main">
										{article.date_publication && (
											<time class="p-label">{formatDate(article.date_publication)}</time>
										)}
										<h3 class="p-display"><a href={`/articles/${article.slug}`}>{article.titre}</a></h3>
									</div>
									<span class="toc-arrow" aria-hidden="true">&rarr;</span>
								</li>
							))}
						</ol>
					)}
				</div>
			</div>
		</section>
	)}

	<!-- ===== CTA : PLANCHE VII ===== -->
	<section class="cta">
		<svg class="cta-target" viewBox="-300 -300 600 600" aria-hidden="true">
			<circle r="290" /><circle r="220" /><circle r="150" /><circle r="80" />
			<path d="M-300,0 H300 M0,-300 V300" />
		</svg>
		<div class="container cta-inner reveal">
			<p class="p-label cta-label"><b>Planche VII</b> &mdash; Parlons-en</p>
			<h2 class="p-display cta-title">Une question<em>&nbsp;?</em></h2>
			<p class="cta-sub">
				Notre équipe est disponible pour vous conseiller dans votre choix
				d'exosquelette.
			</p>
			<a href="/contact" class="p-btn p-btn--paper">Nous contacter <span aria-hidden="true">&rarr;</span></a>
		</div>
	</section>

</Layout>

<script>
	const els = document.querySelectorAll(".reveal");
	if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						io.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
		);
		els.forEach((el) => io.observe(el));
	} else {
		els.forEach((el) => el.classList.add("is-visible"));
	}

	const plate = document.getElementById("plate");
	const cross = document.getElementById("crosshair");
	const read = document.getElementById("chRead");
	const fine = window.matchMedia("(pointer: fine)").matches;
	const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	if (plate && cross && read && fine && !calm) {
		plate.addEventListener("pointermove", (e) => {
			const r = plate.getBoundingClientRect();
			const x = e.clientX - r.left;
			const y = e.clientY - r.top;
			cross.style.setProperty("--mx", `${x}px`);
			cross.style.setProperty("--my", `${y}px`);
			read.textContent = `X ${Math.round((x / r.width) * 480)} · Y ${Math.round((y / r.height) * 590)}`;
			cross.classList.add("on");
		});
		plate.addEventListener("pointerleave", () => cross.classList.remove("on"));
	}
</script>

<style>
	:global(.container) { max-width: 1440px; }

	@media (prefers-reduced-motion: no-preference) {
		.reveal {
			opacity: 0;
			transform: translateY(24px);
			transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
			transition-delay: var(--delay, 0s);
		}
		.reveal.is-visible {
			opacity: 1;
			transform: translateY(0);
		}
		.hero-line {
			opacity: 0;
			transform: translateY(0.35em);
			animation: line-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
			animation-delay: calc(0.05s + var(--i, 0) * 0.14s);
		}
		.scribble path {
			stroke-dasharray: 1;
			stroke-dashoffset: 1;
			animation: scribble 1s ease 0.95s forwards;
		}
	}
	@keyframes line-in {
		to { opacity: 1; transform: translateY(0); }
	}
	@keyframes scribble {
		to { stroke-dashoffset: 0; }
	}

	/* ── En-têtes de section ── */
	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 3rem;
	}
	.section-head .p-label {
		margin-bottom: 1rem;
	}
	.section-title {
		font-size: clamp(2.4rem, 4.6vw, 4.6rem);
		margin: 0;
	}
	.link-line {
		font-family: var(--f-mono);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink);
		text-decoration: none;
		padding-bottom: 4px;
		background: linear-gradient(var(--vermilion), var(--vermilion)) left bottom / 100% 1px no-repeat;
		transition: background-size 0.25s ease, color 0.2s;
		white-space: nowrap;
	}
	.link-line:hover {
		color: var(--vermilion);
		background-size: 0 1px;
	}

	/* ── HERO ── */
	.hero {
		position: relative;
		border-bottom: 1px solid var(--ink);
	}
	.hero-inner {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: clamp(2rem, 4vw, 5rem);
		align-items: center;
		padding: clamp(2.5rem, 5vw, 5rem) 1.5rem clamp(3rem, 5vw, 5rem);
	}
	.hero-kicker {
		margin-bottom: 1.75rem;
	}
	.hero h1 {
		font-size: clamp(2.7rem, 5.6vw, 6rem);
		margin-bottom: 1.75rem;
	}
	.hero-line {
		display: block;
	}
	.hero-line--em {
		position: relative;
		display: inline-block;
		padding-bottom: 0.12em;
	}
	.scribble {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.05em;
		width: 100%;
		height: 0.22em;
		overflow: visible;
	}
	.scribble path {
		fill: none;
		stroke: var(--vermilion);
		stroke-width: 3;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}
	.hero-sub {
		color: var(--ink-soft);
		font-size: clamp(1.05rem, 1.25vw, 1.2rem);
		line-height: 1.7;
		max-width: 46ch;
		margin-bottom: 2.25rem;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.1rem;
		margin-bottom: 3rem;
	}

	.nomenclature .p-label {
		margin-bottom: 0.9rem;
	}
	.nomenclature ol {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}
	.nomenclature a {
		font-family: var(--f-mono);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--ink);
		text-decoration: none;
		display: inline-flex;
		gap: 0.6rem;
		padding-bottom: 2px;
		border-bottom: 1px solid var(--rule);
		transition: color 0.2s, border-color 0.2s;
	}
	.nomenclature a i {
		font-style: normal;
		color: var(--vermilion);
		font-weight: 600;
	}
	.nomenclature a:hover {
		color: var(--vermilion);
		border-color: var(--vermilion);
	}

	.hero-right {
		display: flex;
		justify-content: center;
	}
	.plate {
		position: relative;
		width: 100%;
		max-width: 620px;
		background: var(--paper);
		border: 1px solid var(--rule);
		padding: 3.25rem 1.5rem 3.5rem;
		box-shadow: 10px 10px 0 var(--paper-3);
	}
	.plate-tag {
		position: absolute;
		top: 1rem;
		left: 1.25rem;
		right: 1.25rem;
	}
	.plate-note {
		position: absolute;
		left: 1.25rem;
		bottom: 1rem;
		font-size: 0.64rem;
		opacity: 0.8;
	}
	.plate-fig {
		position: relative;
		z-index: 1;
	}
	.crosshair {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s;
		z-index: 2;
	}
	.crosshair.on { opacity: 1; }
	.ch-x, .ch-y {
		position: absolute;
		background: repeating-linear-gradient(var(--dir, 90deg), var(--vermilion) 0 4px, transparent 4px 8px);
		opacity: 0.7;
	}
	.ch-x {
		--dir: 180deg;
		top: 0;
		bottom: 0;
		width: 1px;
		left: 0;
		transform: translateX(var(--mx, 0px));
	}
	.ch-y {
		--dir: 90deg;
		left: 0;
		right: 0;
		height: 1px;
		top: 0;
		transform: translateY(var(--my, 0px));
	}
	.ch-read {
		position: absolute;
		left: 0;
		top: 0;
		transform: translate(calc(var(--mx, 0px) + 10px), calc(var(--my, 0px) + 10px));
		font-family: var(--f-mono);
		font-size: 0.62rem;
		letter-spacing: 0.1em;
		background: var(--vermilion);
		color: var(--paper);
		padding: 2px 6px;
		white-space: nowrap;
	}

	.cartouche {
		border-top: 1px solid var(--ink);
		background: var(--paper);
	}
	.cartouche-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding: 0 1.5rem;
	}
	.cell {
		padding: 1rem 1.25rem 1.1rem;
		border-left: 1px solid var(--rule);
	}
	.cell:first-child {
		border-left: none;
		padding-left: 0;
	}
	.cell .p-label {
		display: block;
		font-size: 0.62rem;
		margin-bottom: 0.3rem;
	}
	.cell p {
		font-family: var(--f-display);
		font-size: 1.05rem;
		font-variation-settings: "opsz" 24;
		line-height: 1.3;
	}

	/* ── INDEX DES MARQUES ── */
	.brands {
		padding: clamp(4rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
		background: var(--paper);
	}
	.brand-index {
		list-style: none;
		border-bottom: 1px solid var(--ink);
	}
	.brand-index a {
		display: grid;
		grid-template-columns: 4.5rem 1fr auto 4rem;
		align-items: baseline;
		gap: 1rem;
		padding: 0.6rem 1rem 0.9rem 0;
		border-top: 1px solid var(--ink);
		text-decoration: none;
		color: var(--ink);
		transition: background 0.25s ease, color 0.25s ease, padding 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.bi-n {
		font-family: var(--f-mono);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--vermilion);
		letter-spacing: 0.1em;
		align-self: center;
	}
	.bi-name {
		font-family: var(--f-display);
		font-size: clamp(2.6rem, 8.2vw, 8rem);
		font-weight: 300;
		font-variation-settings: "opsz" 144;
		letter-spacing: -0.04em;
		line-height: 1;
		overflow-wrap: anywhere;
	}
	.bi-meta {
		font-family: var(--f-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-soft);
		align-self: center;
		white-space: nowrap;
	}
	.bi-arrow {
		font-size: 2.2rem;
		justify-self: end;
		align-self: center;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.brand-index a:hover {
		background: var(--ink);
		color: var(--paper);
		padding-left: 1.5rem;
	}
	.brand-index a:hover .bi-name {
		font-style: italic;
		font-variation-settings: "opsz" 144;
	}
	.brand-index a:hover .bi-meta { color: var(--paper-3); }
	.brand-index a:hover .bi-arrow {
		transform: translate(4px, -4px);
		color: var(--vermilion);
	}

	/* ── NEO · SOMA · TECH ── */
	.nst {
		background: var(--paper-2);
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
		padding: clamp(3rem, 6vw, 5rem) 0;
	}
	.nst-head { margin-bottom: 2.5rem; }
	.nst-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border: 1px solid var(--ink);
		background: var(--paper);
	}
	.entry {
		position: relative;
		overflow: hidden;
		padding: clamp(1.75rem, 3vw, 3rem);
		border-left: 1px solid var(--ink);
		--tone: var(--ink);
	}
	.entry:first-child { border-left: none; }
	.entry--soma { --tone: var(--blueprint); }
	.entry--tech { --tone: var(--vermilion); }
	.entry-glyph {
		position: absolute;
		right: -0.05em;
		top: -0.2em;
		font-family: var(--f-display);
		font-size: clamp(10rem, 16vw, 16rem);
		font-weight: 200;
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 1px var(--tone);
		opacity: 0.28;
		pointer-events: none;
		user-select: none;
	}
	.entry h3 {
		position: relative;
		font-size: clamp(3.4rem, 5.4vw, 5.6rem);
		color: var(--tone);
		margin: 1.25rem 0 0.75rem;
	}
	.entry-ety {
		position: relative;
		font-family: var(--f-mono);
		font-size: 0.8rem;
		color: var(--ink-soft);
		padding-bottom: 1rem;
		margin-bottom: 1rem;
		border-bottom: 1px dashed var(--rule-strong);
	}
	.entry-ety em {
		font-family: var(--f-display);
		font-size: 1.05rem;
		color: var(--ink);
	}
	.entry-def {
		position: relative;
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--ink);
		max-width: 34ch;
	}

	/* ── CHIFFRES ── */
	.stats {
		padding: clamp(2.5rem, 5vw, 4rem) 0;
		background: var(--paper);
		border-bottom: 1px solid var(--ink);
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}
	.stat {
		padding: 0.5rem 1.5rem;
		border-left: 1px solid var(--rule);
	}
	.stat:first-child { border-left: none; padding-left: 0; }
	.stat-value {
		font-family: var(--f-display);
		font-size: clamp(3rem, 6vw, 6rem);
		font-weight: 260;
		font-variation-settings: "opsz" 144;
		letter-spacing: -0.05em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		margin-bottom: 0.75rem;
	}

	/* ── PRODUITS ── */
	.produits {
		padding: clamp(4rem, 8vw, 7rem) 0;
		background: var(--paper);
	}
	.produits-bento {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		grid-template-rows: repeat(2, minmax(240px, auto));
		gap: 1.75rem;
	}
	.prod {
		position: relative;
		display: flex;
		background: var(--paper);
		border: 1px solid var(--ink);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.prod:hover {
		transform: translate(-4px, -4px);
		box-shadow: 8px 8px 0 var(--vermilion);
	}
	.prod--featured {
		grid-row: 1 / 3;
		flex-direction: column;
	}
	.prod:not(.prod--featured) .prod-media {
		width: 42%;
		flex-shrink: 0;
		border-right: 1px solid var(--ink);
	}
	.prod--featured .prod-media {
		flex: 1;
		min-height: 320px;
		border-bottom: 1px solid var(--ink);
	}
	.prod-media {
		position: relative;
		overflow: hidden;
		background-size: 60px 60px, 60px 60px, 12px 12px, 12px 12px;
	}
	.prod-media img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		mix-blend-mode: multiply;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.prod:hover .prod-media img { transform: scale(1.05); }
	.prod-empty {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.prod-fig {
		position: absolute;
		left: 0.9rem;
		top: 0.85rem;
		background: var(--paper);
		padding: 2px 6px;
		border: 1px solid var(--rule);
	}
	.prod-stamp {
		position: absolute;
		right: 1rem;
		top: 1rem;
	}
	.prod-body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.4rem 1.5rem 1.5rem;
		flex: 1;
		min-width: 0;
	}
	.prod--featured .prod-body { flex: none; }
	.prod-body h3 {
		font-size: 1.55rem;
		font-weight: 420;
		font-variation-settings: "opsz" 48;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}
	.prod--featured .prod-body h3 { font-size: clamp(2rem, 3vw, 2.8rem); }
	.prod-body h3 a {
		color: var(--ink);
		text-decoration: none;
	}
	.prod-body h3 a::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 3;
	}
	.prod-desc {
		color: var(--ink-soft);
		font-size: 0.98rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.prod-footer {
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px dashed var(--rule-strong);
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}
	.prod-price {
		font-family: var(--f-mono);
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--ink);
	}
	.prod--featured .prod-price { font-size: 1.9rem; }
	.prod-prices {
		display: flex;
		align-items: baseline;
		gap: 0.65rem;
		flex-wrap: wrap;
	}
	.prod-price--old {
		font-size: 1rem;
		text-decoration: line-through;
		color: var(--ink-soft);
	}
	.prod-price--promo { color: var(--vermilion); }
	.prod-arrow {
		width: 44px;
		height: 44px;
		border: 1px solid var(--ink);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.2rem;
		flex-shrink: 0;
		transition: background 0.2s, color 0.2s;
	}
	.prod:hover .prod-arrow {
		background: var(--ink);
		color: var(--paper);
	}

	/* ── MISSION ── */
	.mission {
		padding: clamp(4rem, 8vw, 7rem) 0;
		background: var(--paper-2);
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
	}
	.mission-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2.5rem, 6vw, 7rem);
		align-items: start;
	}
	.mission-text .p-label { margin-bottom: 1rem; }
	.mission-text .section-title {
		font-size: clamp(2.6rem, 4.6vw, 4.8rem);
		margin-bottom: 2rem;
	}
	.mission-text p:not(.p-label) {
		font-size: 1.12rem;
		line-height: 1.8;
		color: var(--ink-soft);
		margin-bottom: 1.25rem;
		max-width: 52ch;
	}
	.mission-text strong {
		color: var(--ink);
		font-weight: 600;
		background: linear-gradient(transparent 62%, rgba(232, 57, 29, 0.28) 62%);
	}
	.piliers {
		list-style: none;
		border-top: 1px solid var(--ink);
	}
	.pilier {
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		gap: 1.25rem;
		align-items: center;
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--ink);
		transition: padding 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s;
	}
	.pilier:hover {
		padding-left: 1rem;
		background: var(--paper);
	}
	.pilier-n {
		font-family: var(--f-display);
		font-style: italic;
		font-size: 2.6rem;
		font-weight: 300;
		color: var(--vermilion);
		line-height: 1;
	}
	.pilier-content h3 {
		font-size: 1.7rem;
		font-weight: 400;
		letter-spacing: -0.02em;
		margin-bottom: 0.3rem;
	}
	.pilier-content p {
		color: var(--ink-soft);
		font-size: 0.98rem;
		line-height: 1.55;
	}
	.pilier-icon {
		color: var(--ink);
		flex-shrink: 0;
	}

	/* ── ARTICLES ── */
	.articles {
		padding: clamp(4rem, 8vw, 7rem) 0;
		background: var(--paper);
	}
	.articles-layout {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: clamp(1.75rem, 4vw, 4rem);
		align-items: start;
	}
	.art-featured {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.art-img {
		display: block;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--ink);
		overflow: hidden;
		position: relative;
		background-size: 60px 60px, 60px 60px, 12px 12px, 12px 12px;
	}
	.art-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		mix-blend-mode: multiply;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.art-featured:hover .art-img img { transform: scale(1.04); }
	.art-meta {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 0.75rem;
	}
	.art-featured h3 {
		font-size: clamp(1.8rem, 2.8vw, 2.7rem);
		font-weight: 400;
		letter-spacing: -0.025em;
		line-height: 1.12;
		margin-bottom: 1rem;
	}
	.art-featured h3 a,
	.toc-main h3 a {
		color: inherit;
		text-decoration: none;
		background: linear-gradient(var(--vermilion), var(--vermilion)) left 100% / 0 2px no-repeat;
		transition: background-size 0.3s ease;
	}
	.art-featured h3 a:hover,
	.toc-main h3 a:hover { background-size: 100% 2px; }
	.art-excerpt {
		color: var(--ink-soft);
		font-size: 1.05rem;
		line-height: 1.7;
		margin-bottom: 1.5rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.toc {
		list-style: none;
		border-top: 1px solid var(--ink);
	}
	.toc-row {
		position: relative;
		display: grid;
		grid-template-columns: 3rem 1fr auto;
		gap: 1rem;
		align-items: center;
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--ink);
		transition: padding 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.toc-row:hover { padding-left: 0.75rem; }
	.toc-n {
		font-family: var(--f-mono);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--vermilion);
		letter-spacing: 0.1em;
	}
	.toc-main h3 {
		font-size: 1.45rem;
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin-top: 0.35rem;
	}
	.toc-main h3 a::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	.toc-arrow {
		font-size: 1.4rem;
		transition: transform 0.25s, color 0.25s;
	}
	.toc-row:hover .toc-arrow {
		transform: translateX(6px);
		color: var(--vermilion);
	}

	/* ── CTA ── */
	.cta {
		position: relative;
		overflow: hidden;
		background: var(--ink);
		color: var(--paper);
		text-align: center;
		padding: clamp(5rem, 10vw, 9rem) 0;
	}
	.cta-target {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(150vw, 1100px);
		transform: translate(-50%, -50%);
		pointer-events: none;
	}
	.cta-target circle,
	.cta-target path {
		fill: none;
		stroke: var(--paper);
		stroke-width: 1;
		opacity: 0.16;
	}
	.cta-target circle:nth-child(2n) { stroke-dasharray: 3 7; }
	.cta-inner {
		position: relative;
		z-index: 1;
	}
	.cta-label {
		color: var(--paper-3);
		margin-bottom: 1.5rem;
	}
	.cta-title {
		font-size: clamp(3.4rem, 10vw, 9.5rem);
		color: var(--paper);
		margin-bottom: 1.5rem;
	}
	.cta-sub {
		color: var(--paper-3);
		font-size: 1.1rem;
		line-height: 1.7;
		max-width: 42ch;
		margin: 0 auto 2.5rem;
	}

	/* ── UTILITAIRES ── */
	.error-box {
		border: 1px solid var(--vermilion);
		color: var(--vermilion);
		padding: 1.5rem;
		text-align: center;
		font-family: var(--f-mono);
	}
	.empty-box {
		border: 1px dashed var(--ink);
		padding: 3rem;
		text-align: center;
		color: var(--ink-soft);
		font-family: var(--f-mono);
	}

	/* ── RESPONSIVE ── */
