---
// page : /boutique/[marque]  — page de marque indexable (SEO)
import Layout from '../../layouts/Layout.astro';
import { fetchDirectus, directusUrl, slugifyBrand } from '../../lib/directus';

const { marque: marqueSlug } = Astro.params;

let produits: any[] = [];
let brandName = '';
let errorMessage: string | null = null;

try {
    const all = await fetchDirectus(
        '/items/Produits?fields=id,Nom_du_produit,prix,descripton_simple,slug,image,marque,promo,prix_promo&limit=200'
    );
    const matched = (all || []).filter(
        (p: any) => p.marque && slugifyBrand(p.marque) === marqueSlug
    );
    if (matched.length > 0) {
        brandName = matched[0].marque;
        produits = matched;
    }
} catch (error: any) {
    console.error(`Erreur page marque ${marqueSlug}:`, error);
    errorMessage = error.message;
}

// Marque inconnue (et pas d'erreur Directus) : on renvoie vers la boutique générale.
if (!brandName && !errorMessage) {
    return Astro.redirect('/boutique', 302);
}

// Introductions éditoriales par marque (clé = slug), avec repli générique.
const BRAND_INTROS: Record<string, string> = {
    'ski-mojo':
        "Ski-Mojo est l'exosquelette de ski passif de référence : un système de ressorts qui reprend jusqu'à 33 % de la charge sur les genoux pour skier plus longtemps, sans fatigue ni douleur. Découvrez ci-dessous notre sélection Ski-Mojo.",
    hypershell:
        "Hypershell conçoit des exosquelettes de marche motorisés à assistance intelligente : des moteurs pilotés par IA qui allègent vos pas en randonnée et au quotidien. Retrouvez ci-dessous la gamme Hypershell sélectionnée par NeoSomaTech.",
    stoko:
        "Stoko réinvente le maintien articulaire avec ses collants exosquelettes : un soutien médical du genou intégré à un vêtement de compression léger et invisible. Voici notre sélection Stoko.",
    dnsys:
        "Dnsys développe des exosquelettes d'assistance pour la marche et l'effort. Découvrez ci-dessous les modèles Dnsys référencés par NeoSomaTech.",
};
const intro =
    BRAND_INTROS[marqueSlug ?? ''] ||
    `Découvrez la sélection d'exosquelettes ${brandName} référencée par NeoSomaTech : caractéristiques, prix et conseils d'achat.`;

const title = `Exosquelettes ${brandName} : modèles, prix et avis | NeoSomaTech`;
const description = `Gamme d'exosquelettes ${brandName} sélectionnée par NeoSomaTech : modèles, caractéristiques, prix et guide d'achat. Livraison France.`;

const itemListSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Exosquelettes ${brandName} — NeoSomaTech`,
    url: `https://neosomatech.com/boutique/${marqueSlug}`,
    numberOfItems: produits.length,
    itemListElement: produits.map((p: any, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://neosomatech.com/produits/${p.slug || p.id}`,
        name: p.Nom_du_produit,
    })),
};
---

<Layout title={title} description={description}>
    {produits.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} is:inline />
    )}

    <div class="p-page p-page--wide">
    <header class="p-pagehead">
        <div class="p-crumb">
            <a href="/">Accueil</a><span>/</span><a href="/boutique">Boutique</a><span>/</span><span>{brandName}</span>
        </div>
        <h1 class="p-display p-title">Exosquelettes <em>{brandName}</em></h1>
        <p class="brand-intro p-lede">{intro}</p>
    </header>

    <div class="brand-content">
        {errorMessage ? (
            <div class="p-notice p-notice--error">{errorMessage}</div>
        ) : produits.length === 0 ? (
            <div class="p-notice"><p>Aucun produit {brandName} disponible pour le moment.</p></div>
        ) : (
            <div class="grid">
                {produits.map((p) => {
                    const isPromoValid = p.promo && p.prix_promo;
                    const displayPromoPrice = isPromoValid
                        ? (String(p.prix_promo).includes('€') ? p.prix_promo : `${p.prix_promo} €`)
                        : null;
                    return (
                        <article class="card">
                            <a href={`/produits/${p.slug || p.id}`} class="card-img-link p-grid-paper" tabindex="-1" aria-hidden="true">
                                {p.image ? (
                                    <img
                                        src={`${directusUrl}/assets/${p.image}?width=400&format=webp&quality=82`}
                                        alt={p.Nom_du_produit}
                                        loading="lazy"
                                        decoding="async"
                                        width="400"
                                        height="400"
                                    />
                                ) : (
                                    <div class="img-placeholder p-label">Visuel à venir</div>
                                )}
                                {isPromoValid && <span class="p-stamp promo-badge">Promo</span>}
                            </a>
                            <div class="card-body">
                                <div class="card-tag">{brandName}</div>
                                <h2 class="card-title">
                                    <a href={`/produits/${p.slug || p.id}`}>{p.Nom_du_produit}</a>
                                </h2>
                                <p class="card-desc">{p.descripton_simple}</p>
                                <div class="card-footer">
                                    {isPromoValid ? (
                                        <div class="price-wrapper">
                                            <span class="price old-price">{p.prix} €</span>
                                            <span class="price promo-price">{displayPromoPrice}</span>
                                        </div>
                                    ) : (
                                        <span class="price">{p.prix ? `${p.prix} €` : 'Nous contacter'}</span>
                                    )}
                                    <a href={`/produits/${p.slug || p.id}`} class="btn">Voir &rarr;</a>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
        )}

        <div class="all-products-link">
            <a href="/boutique" class="btn btn-outline">&larr; Tous les exosquelettes</a>
        </div>
    </div>
    </div>
</Layout>

<style>
    .brand-content { padding-bottom: 1rem; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 1.75rem; }
    .card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--ink);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s ease, scale 0.28s ease;
    }
    .card:hover { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--vermilion); }
    .card.card-out { opacity: 0; scale: 0.93; pointer-events: none; }
    .card-img-link {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1 / 1;
        padding: 1.5rem;
        overflow: hidden;
        border-bottom: 1px solid var(--ink);
        background-size: 60px 60px, 60px 60px, 12px 12px, 12px 12px;
    }
    .card-img-link img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        mix-blend-mode: multiply;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .card:hover .card-img-link img { transform: scale(1.06); }
    .img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; }
    .promo-badge { position: absolute; top: 0.9rem; right: 0.9rem; z-index: 2; }
    .card-body { padding: 1.4rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: 0.7rem; flex: 1; }
    .card-tag {
        font-family: var(--f-mono);
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--vermilion);
    }
    .card-title, .card-body h3 {
        font-family: var(--f-display);
        font-size: 1.35rem;
        font-weight: 420;
        font-variation-settings: "opsz" 48;
        letter-spacing: -0.02em;
        line-height: 1.15;
    }
    .card-title a, .card-body h3 a { color: var(--ink); text-decoration: none; }
    .card-title a::after, .card-body h3 a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
    .card-desc {
        color: var(--ink-soft);
        font-size: 0.95rem;
        line-height: 1.6;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .card-footer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.75rem;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px dashed var(--rule-strong);
    }
    .price { font-family: var(--f-mono); font-size: 1.3rem; font-weight: 500; letter-spacing: -0.03em; color: var(--ink); }
    .price-wrapper { display: flex; flex-direction: column; line-height: 1.2; }
    .old-price { font-size: 0.85rem; text-decoration: line-through; color: var(--ink-soft); }
    .promo-price { color: var(--vermilion); }
    .card-footer .btn { padding: 0.6rem 0.95rem; font-size: 0.72rem; position: relative; z-index: 2; box-shadow: 3px 3px 0 var(--vermilion); }

    .all-products-link { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--ink); }
</style>
