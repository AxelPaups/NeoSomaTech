---
// page : /articles/[slug]
// Page article avec SEO maximum : meta, og:, json-ld
import Layout from '../../layouts/Layout.astro';
import { fetchDirectus } from '../../lib/directus';
import { linkifyProducts } from '../../lib/linkifyProducts';

const { slug } = Astro.params;

// Redirections 301 d'anciens slugs (majuscules/accents) vers leur version propre.
// Préserve le référencement des URLs déjà indexées après normalisation des slugs.
const SLUG_REDIRECTS: Record<string, string> = {
    'Exosquelette-de-Randonnée-Révolution-ou-Gadget-Sentiers': 'exosquelette-randonnee-revolution-ou-gadget-sentiers',
    // Consolidation du pilier ski (suppression du doublon) vers le slug propre
    'articles-exosquelette-ski-genou': 'exosquelette-ski-genou-guide-complet',
    'exosquelette-ski-guide-complet': 'exosquelette-ski-genou-guide-complet',
};
const decodedSlug = slug ? decodeURIComponent(slug) : '';
const redirectTarget = (slug && SLUG_REDIRECTS[slug]) || (decodedSlug && SLUG_REDIRECTS[decodedSlug]);
if (redirectTarget) {
    return Astro.redirect(`/articles/${redirectTarget}`, 301);
}

let article: any = null;
let errorMessage: string | null = null;
let productsForLinking: { name: string, slug: string }[] = [];

try {
    // 1. Récupérer l'article
    const data = await fetchDirectus(
        `/items/Articles?filter[slug][_eq]=${slug}&fields=id,titre,slug,description_seo,meta_description,contenu,date_publication,auteur,image_principale&limit=1`
    );
    article = Array.isArray(data) ? data[0] : data;

    // 2. Récupérer tous les produits pour les liens automatiques
    if (article) {
        const productsData = await fetchDirectus(`/items/Produits?fields=Nom_du_produit,nom_court,slug&limit=100`);
        if (Array.isArray(productsData)) {
            productsData.forEach((p: any) => {
                // On ajoute le nom complet
                if (p.Nom_du_produit) productsForLinking.push({ name: p.Nom_du_produit, slug: p.slug });
                
                // On ajoute le nom court s'il est différent
                if (p.nom_court && p.nom_court !== p.Nom_du_produit) {
                    productsForLinking.push({ name: p.nom_court, slug: p.slug });
                }
                
                // Cas particuliers pour faciliter la détection (mots clés fréquents)
                const lowerName = p.Nom_du_produit.toLowerCase();
                if (lowerName.includes('ski-mojo')) {
                    if (!productsForLinking.some(x => x.name === 'Ski-Mojo')) productsForLinking.push({ name: 'Ski-Mojo', slug: p.slug });
                    if (!productsForLinking.some(x => x.name === 'Ski Mojo')) productsForLinking.push({ name: 'Ski Mojo', slug: p.slug });
                }
                if (lowerName.includes('hypershell')) {
                    if (!productsForLinking.some(x => x.name === 'Hypershell')) productsForLinking.push({ name: 'Hypershell', slug: p.slug });
                }
                if (lowerName.includes('stoko')) {
                    if (!productsForLinking.some(x => x.name === 'Stoko')) productsForLinking.push({ name: 'Stoko', slug: p.slug });
                }
            });
        }
    }
} catch (error: any) {
    console.error(`Erreur article ${slug}:`, error);
    errorMessage = error.message;
}

if (!article && !errorMessage) {
    return Astro.redirect('/404');
}

// Si l'article est introuvable ou en erreur : renvoyer un vrai 404 (et noindex)
// pour éviter que Google indexe une page d'erreur servie en 200.
if (!article || errorMessage) {
    Astro.response.status = 404;
}

// Application du linkify sur le contenu
const linkifiedContent = article?.contenu ? linkifyProducts(article.contenu, productsForLinking) : '';

const directusUrl = "https://spirited-squid.pikapod.net";
const imageUrl = article?.image_principale
    ? `${directusUrl}/assets/${article.image_principale}`
    : null;

const formatDate = (date: string) => {
    if (!date) return '';
    try {
        const d = new Date(date);
        if (isNaN(d.getTime())) return date;
        return new Intl.DateTimeFormat('fr-FR', { year:'numeric', month:'long', day:'numeric' }).format(d);
    } catch (e) {
        return date;
    }
};

---

<Layout
    title={article ? `${article.titre} | NeoSomaTech` : 'Article non trouvé'}
    description={article?.meta_description || article?.description_seo || 'Article sur les exosquelettes.'}
    image={imageUrl || '/favicon.png'}
    type="article"
    schemaItem={article}
    noindex={!article || !!errorMessage}
>

    {errorMessage ? (
        <div class="container p-notice p-notice--error error-box">
            <strong>⚠️ Erreur :</strong> {errorMessage}
        </div>
    ) : article && (
        <article class="article-wrapper">
            <!-- HERO IMAGE -->
            {imageUrl && (
                <div class="article-hero">
                    <img src={`${imageUrl}?width=1200&format=webp&quality=82`} alt={article.titre} loading="eager" fetchpriority="high" decoding="async" />
                </div>
            )}

            <div class="article-body container">
                <!-- BREADCRUMB -->
                <nav class="p-crumb">
                    <a href="/">Accueil</a><span>/</span>
                    <a href="/articles">Articles</a><span>/</span>
                    <span>{article.titre}</span>
                </nav>

                <!-- META -->
                <div class="article-meta p-label">
                    {article.date_publication && (
                        <time datetime={article.date_publication}>
                            {formatDate(article.date_publication)}
                        </time>
                    )}
                    {article.auteur && (
                        <span>Par {article.auteur === 'Axel Paupier'
                            ? <a href="/auteur/axel-paupier" rel="author" class="author-link">{article.auteur}</a>
                            : article.auteur}</span>
                    )}
                </div>

                <!-- TITRE -->
                <h1 class="p-display">{article.titre}</h1>

                <!-- RÉSUMÉ SEO -->
                {article.description_seo && (
                    <p class="article-lead">{article.description_seo}</p>
                )}

                <!-- CONTENU HTML -->
                {linkifiedContent && (
                    <div class="article-content p-prose" set:html={linkifiedContent} />
                )}

                <!-- FOOTER ARTICLE -->
                <div class="article-footer">
                    <a href="/articles" class="btn btn-outline">&larr; Retour aux articles</a>
                </div>
            </div>
        </article>
    )}
</Layout>

<style>
    .article-hero {
        width: 100%;
        overflow: hidden;
        border-bottom: 1px solid var(--ink);
        background: var(--paper-2);
    }
    .article-hero img {
        display: block;
        width: 100%;
        height: clamp(240px, 40vw, 520px);
        object-fit: cover;
    }

    .article-body {
        max-width: 820px;
        padding-top: 3rem;
        padding-bottom: 6rem;
    }
    .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-bottom: 1.25rem;
    }
    .article-meta :global(.author-link) { font-weight: 600; }
    h1 {
        font-size: clamp(2.2rem, 5.4vw, 4rem);
        line-height: 1.04;
        margin-bottom: 1.75rem;
    }
    .article-lead {
        font-family: var(--f-display);
        font-style: italic;
        font-weight: 350;
        font-variation-settings: "opsz" 48;
        font-size: clamp(1.25rem, 2.2vw, 1.55rem);
        line-height: 1.55;
        color: var(--ink-soft);
        margin-bottom: 2.75rem;
        padding-bottom: 2.25rem;
        border-bottom: 1px solid var(--ink);
    }
    .article-content { font-size: 1.1rem; }

    .article-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--ink);
    }
    .error-box { max-width: 640px; margin: 4rem auto; }
</style>
