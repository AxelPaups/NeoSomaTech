---
import Layout from '../layouts/Layout.astro';
import { fetchDirectus, fetchPageSEO } from '../lib/directus';
import { getFx } from '../lib/fx';
import { normalizeCurrency, moneyHtml } from '../lib/money';

const directusUrl = "https://spirited-squid.pikapod.net";

let products: any[] = [];
let errorMessage: string | null = null;

try {
    // fields to request, including the new ones the user will add + variantes
    const query = `/items/Produits?fields=id,Nom_du_produit,nom_court,slug,image,prix,devise,marque,poids,autonomie,assistance_max,temps_charge,materiaux,garantie,certification,comparateur_defaut,variantes.*&limit=50`;
    const data = await fetchDirectus(query);
    products = Array.isArray(data) ? data : [];
} catch (error: any) {
    console.error("Erreur lors de la récupération des produits :", error);
    errorMessage = error.message;
}

// Prepare data for the client
const flatOptions: any[] = [];

products.forEach(p => {
    // Produit principal
    flatOptions.push({
        id: p.id,
        nom: p.Nom_du_produit,
        nom_court: p.nom_court,
        slug: p.slug,
        image: p.image ? `${directusUrl}/assets/${p.image}?width=700&format=webp&quality=82` : null,
        prix: p.prix,
        devise: normalizeCurrency(p.devise),
        marque: p.marque,
        poids: p.poids || 'N/A',
        autonomie: p.autonomie || 'N/A',
        assistance_max: p.assistance_max || 'N/A',
        temps_charge: p.temps_charge || 'N/A',
        materiaux: p.materiaux || 'N/A',
        garantie: p.garantie || 'N/A',
        certification: p.certification || 'N/A',
        comparateur_defaut: p.comparateur_defaut === true || p.comparateur_defaut === 'true' || p.comparateur_defaut === 1 || p.comparateur_defaut === '1'
    });

    // Ses variantes
    if (p.variantes && p.variantes.length > 0) {
        p.variantes.forEach((v: any) => {
            flatOptions.push({
                id: `v_${v.id}`,
                nom: v.Nom_du_produit || p.Nom_du_produit,
                nom_court: v.nom_court || v.Nom_du_produit,
                parent_nom: p.nom_court || p.Nom_du_produit,
                slug: p.slug,
                image: v.Image ? `${directusUrl}/assets/${v.Image}?width=700&format=webp&quality=82` : (p.image ? `${directusUrl}/assets/${p.image}?width=700&format=webp&quality=82` : null),
                prix: v.prix || p.prix,
                devise: normalizeCurrency(p.devise),
                marque: p.marque,
                poids: v.poids || p.poids || 'N/A',
                autonomie: v.autonomie || p.autonomie || 'N/A',
                assistance_max: v.assistance_max || p.assistance_max || 'N/A',
                temps_charge: v.temps_charge || p.temps_charge || 'N/A',
                materiaux: v.materiaux || p.materiaux || 'N/A',
                garantie: v.garantie || p.garantie || 'N/A',
                certification: v.certification || p.certification || 'N/A',
                comparateur_defaut: false
            });
        });
    }
});

const productsJson = JSON.stringify(flatOptions);

// Colonnes pré-remplies côté serveur (même règle que le script client) :
// le contenu est ainsi présent dans le HTML pour les moteurs de recherche.
let defaultIds = flatOptions.filter((p) => p.comparateur_defaut).map((p) => String(p.id));
if (defaultIds.length < 3) {
    const otherIds = flatOptions.filter((p) => !p.comparateur_defaut).map((p) => String(p.id));
    defaultIds = [...defaultIds, ...otherIds].slice(0, 3);
}
const defaultProducts = defaultIds.slice(0, 3).map((id) => flatOptions.find((p) => String(p.id) === id));

const optionLabel = (p: any) => (p.parent_nom ? `${p.parent_nom} - ${p.nom_court}` : p.nom_court || p.nom);
const orDash = (v: unknown) => (!v || v === 'N/A' ? '—' : String(v));
const fx = await getFx();
const fxCtx = { rate: fx.usdPerEur, target: 'EUR' as const };
const priceHtml = (p: any) => (p.prix ? moneyHtml(p.prix, p.devise, fxCtx) : 'Sur demande');

const specRows: [string, string][] = [
    ['Poids', 'poids'],
    ['Autonomie', 'autonomie'],
    ['Assistance max.', 'assistance_max'],
    ['Temps de charge', 'temps_charge'],
    ['Matériaux', 'materiaux'],
    ['Garantie', 'garantie'],
    ['Certification', 'certification'],
];

// Tableau récapitulatif : un produit = une ligne (les variantes de taille sont exclues)
const tableProducts = flatOptions.filter((p) => !p.parent_nom);

const seo = await fetchPageSEO(
    "comparateur",
    "Comparateur de produits | NeoSomaTech",
    "Comparez nos différents exosquelettes pour trouver celui qui correspond à vos besoins."
);
---

<Layout title={seo.title} description={seo.description}>
    <div class="p-page p-page--wide">
        <header class="comparateur-header p-pagehead">
            <div class="p-crumb"><a href="/">Accueil</a><span>/</span><span>Comparateur</span></div>
            <h1 class="main-title p-display p-title">Comparateur <em>de produits</em></h1>
            <p class="subtitle p-lede">Sélectionnez jusqu'à 3 produits pour comparer leurs caractéristiques en détail.</p>
        </header>

        {errorMessage ? (
            <div class="p-notice p-notice--error">{errorMessage}</div>
        ) : products.length === 0 ? (
            <div class="p-notice">Aucun produit disponible pour la comparaison.</div>
        ) : (
            <>
            <div class="comparateur-grid" id="comparateur-app" data-products={productsJson}>
                {[0, 1, 2].map((colIndex) => {
                    const dp = defaultProducts[colIndex];
                    return (
                    <div class="compare-col" data-col={colIndex}>
                        <div class="custom-select-wrapper">
                            <div class="custom-select" id={`select-col-${colIndex}`}>
                                <div class="select-trigger">
                                    <span class="trigger-text">{dp ? optionLabel(dp) : '-- Sélectionner un produit --'}</span>
                                    <span class="arrow">▼</span>
                                </div>
                                <div class="select-options-container">
                                    <div class="select-options">
                                        <div class="select-option" data-value="">-- Sélectionner un produit --</div>
                                        {flatOptions.map((p) => (
                                            <div class:list={['select-option', { selected: dp && String(dp.id) === String(p.id) }]} data-value={p.id}>
                                                {optionLabel(p)}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="product-card empty" style={dp ? 'display: none;' : undefined}>
                            <img src="/favicon.png" alt="NST Logo" class="placeholder-logo" />
                            <p>Sélectionnez un produit</p>
                        </div>

                        <div class="product-card filled" style={dp ? 'display: flex;' : 'display: none;'}>
                            <div class="product-img-wrapper">
                                <img src={dp?.image ?? ''} alt={dp?.nom ?? ''} class="product-img" style={dp?.image ? 'display: block;' : 'display: none;'} loading="lazy" decoding="async" />
                            </div>

                            <div class="product-info-top">
                                <div class="brand-tag" style={dp?.marque ? 'opacity: 1;' : 'opacity: 0;'}>{dp?.marque || 'X'}</div>
                                <h2 class="product-name">{dp?.nom ?? ''}</h2>
                                <div class="product-price"><Fragment set:html={dp ? (dp.prix ? moneyHtml(dp.prix, dp.devise, fxCtx) : 'Contact') : ''} /></div>
                                <a href={dp ? `/produits/${dp.slug}` : '#'} class="btn btn-buy btn-small">Voir le produit</a>
                            </div>

                            <div class="product-specs">
                                {specRows.map(([label, field]) => (
                                    <div class="spec-row">
                                        <span class="spec-label">{label}</span>
                                        <span class="spec-val" data-field={field}>{dp ? (dp[field] || 'N/A') : ''}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                    );
                })}
            </div>

            <section class="compare-table-section" aria-labelledby="compare-table-title">
                <p class="p-label"><b>Tableau</b> &mdash; Vue d'ensemble</p>
                <h2 id="compare-table-title" class="p-display compare-table-title">Tous les exosquelettes <em>côte à côte</em></h2>
                <div class="compare-table-wrap">
                    <table class="compare-table">
                        <caption class="visually-hidden">Comparatif des caractéristiques de tous les exosquelettes référencés sur NeoSomaTech</caption>
                        <thead>
                            <tr>
                                <th scope="col">Modèle</th>
                                <th scope="col">Prix</th>
                                {specRows.map(([label]) => <th scope="col">{label}</th>)}
                            </tr>
                        </thead>
                        <tbody>
                            {tableProducts.map((p) => (
                                <tr>
                                    <th scope="row">
                                        <a href={`/produits/${p.slug}`}>{p.nom_court || p.nom}</a>
                                        {p.marque && <span class="compare-brand">{p.marque}</span>}
                                    </th>
                                    <td class="compare-price"><Fragment set:html={priceHtml(p)} /></td>
                                    {specRows.map(([, field]) => <td>{orDash(p[field])}</td>)}
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>
            </>
        )}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const app = document.getElementById('comparateur-app');
            if (!app) return;

            const productsData = JSON.parse(app.getAttribute('data-products') || '[]');
            const cols = app.querySelectorAll('.compare-col');

            // Set default products based on 'comparateur_defaut' flag
            let defaultIds = productsData.filter((p: any) => p.comparateur_defaut).map((p: any) => String(p.id));
            if (defaultIds.length < 3) {
                const otherIds = productsData.filter((p: any) => !p.comparateur_defaut).map((p: any) => String(p.id));
                defaultIds = [...defaultIds, ...otherIds].slice(0, 3);
            }
            const defaults = defaultIds.slice(0, 3);

            cols.forEach((col, index) => {
                const customSelect = col.querySelector('.custom-select') as HTMLElement;
                const trigger = customSelect.querySelector('.select-trigger') as HTMLElement;
                const triggerText = trigger.querySelector('.trigger-text') as HTMLElement;
                const options = customSelect.querySelectorAll('.select-option');
                
                const emptyCard = col.querySelector('.product-card.empty') as HTMLElement;
                const filledCard = col.querySelector('.product-card.filled') as HTMLElement;

                // Toggle dropdown
                trigger.addEventListener('click', (e) => {
                    e.stopPropagation();
                    document.querySelectorAll('.custom-select').forEach(s => {
                        if (s !== customSelect) s.classList.remove('open');
                    });
                    customSelect.classList.toggle('open');
                });

                // Close when clicking outside
                document.addEventListener('click', () => {
                    customSelect.classList.remove('open');
                });

                // Update UI function
                const updateCard = (productId: string) => {
                    if (!productId) {
                        emptyCard.style.display = 'flex';
                        filledCard.style.display = 'none';
                        return;
                    }

                    const product = productsData.find((p: any) => String(p.id) === String(productId));
                    if (!product) return;

                    emptyCard.style.display = 'none';
                    filledCard.style.display = 'flex';

                    // Update Image
                    const img = filledCard.querySelector('.product-img') as HTMLImageElement;
                    if (product.image) {
                        img.src = product.image;
                        img.style.display = 'block';
                    } else {
                        img.style.display = 'none';
                    }

                    // Update Top Info
                    const brandTag = filledCard.querySelector('.brand-tag') as HTMLElement;
                    if (product.marque) {
                        brandTag.textContent = product.marque;
                        brandTag.style.opacity = '1';
                    } else {
                        brandTag.textContent = 'X';
                        brandTag.style.opacity = '0';
                    }

                    (filledCard.querySelector('.product-name') as HTMLElement).textContent = product.nom;
                    (filledCard.querySelector('.product-price') as HTMLElement).innerHTML = product.prix
                        ? ((window as any).nstCurrency?.moneyHtml(product.prix, product.devise) ?? `${product.prix} €`)
                        : 'Contact';
                    (filledCard.querySelector('.btn-buy') as HTMLAnchorElement).href = `/produits/${product.slug}`;

                    // Update Specs
                    const setSpec = (field: string, val: string) => {
                        const el = filledCard.querySelector(`[data-field="${field}"]`) as HTMLElement;
                        if (el) el.textContent = val || 'N/A';
                    };
                    
                    setSpec('poids', product.poids);
                    setSpec('autonomie', product.autonomie);
                    setSpec('assistance_max', product.assistance_max);
                    setSpec('temps_charge', product.temps_charge);
                    setSpec('materiaux', product.materiaux);
                    setSpec('garantie', product.garantie);
                    setSpec('certification', product.certification);
                };

                // Handle option selection
                options.forEach(opt => {
                    opt.addEventListener('click', () => {
                        const val = opt.getAttribute('data-value') || '';
                        triggerText.textContent = opt.textContent;
                        updateCard(val);
                        customSelect.classList.remove('open');
                        
                        options.forEach(o => o.classList.remove('selected'));
                        opt.classList.add('selected');
                    });
                });

                // Apply defaults
                if (defaults[index]) {
                    const defaultOpt = Array.from(options).find(o => o.getAttribute('data-value') === String(defaults[index]));
                    if (defaultOpt) {
                        triggerText.textContent = defaultOpt.textContent;
                        defaultOpt.classList.add('selected');
                        updateCard(defaults[index]);
                    }
                }
            });
        });
    </script>

    <style>
        .comparateur-header { margin-bottom: 3rem; }

        .comparateur-grid {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
            gap: 2rem;
            align-items: flex-start;
        }
        @media (min-width: 768px) {
            .comparateur-grid { grid-template-columns: repeat(3, 1fr); }
        }

        .compare-col { display: flex; flex-direction: column; gap: 1.5rem; min-width: 0; height: 100%; }

        /* Sélecteur */
        .custom-select-wrapper { position: relative; z-index: 50; }
        .custom-select { position: relative; width: 100%; }
        .select-trigger {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
            background: var(--surface);
            border: 1px solid var(--ink);
            color: var(--ink);
            font-family: var(--f-mono);
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.06em;
            cursor: pointer;
            transition: box-shadow 0.2s, transform 0.2s;
            user-select: none;
        }
        .trigger-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .custom-select:hover .select-trigger { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--vermilion); }
        .custom-select.open .select-trigger { background: var(--ink); color: var(--paper); transform: none; box-shadow: none; }
        .select-trigger .arrow { font-size: 0.65rem; transition: transform 0.3s ease; flex-shrink: 0; }
        .custom-select.open .arrow { transform: rotate(180deg); }

        .select-options-container {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: var(--surface);
            border: 1px solid var(--ink);
            border-top: none;
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
            z-index: 100;
            box-shadow: 6px 6px 0 var(--vermilion);
        }
        .custom-select.open .select-options-container { opacity: 1; visibility: visible; transform: translateY(0); }
        .select-options { max-height: 260px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--ink) transparent; }
        .select-option {
            padding: 0.85rem 1.15rem;
            color: var(--ink-soft);
            cursor: pointer;
            font-size: 0.95rem;
            border-left: 3px solid transparent;
            transition: background 0.15s, color 0.15s, padding 0.2s;
        }
        .select-option:hover { background: rgba(16, 26, 51, 0.06); color: var(--ink); border-left-color: var(--vermilion); padding-left: 1.4rem; }
        .select-option.selected { background: var(--ink); color: var(--paper); font-weight: 600; border-left-color: var(--vermilion); }

        /* Fiches */
        .product-card {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: var(--surface);
            border: 1px solid var(--ink);
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .product-card.filled:hover { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--vermilion); }

        .product-card.empty {
            align-items: center;
            justify-content: flex-start;
            padding: 6rem 2rem 4rem;
            border: 1px dashed var(--ink);
            background: transparent;
            color: var(--ink-soft);
            text-align: center;
            gap: 1rem;
            font-family: var(--f-mono);
            font-size: 0.78rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        .placeholder-logo { width: 4rem; height: 4rem; object-fit: contain; opacity: 0.25; margin-bottom: 0.5rem; }

        .product-img-wrapper {
            width: 100%;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border-bottom: 1px solid var(--ink);
            padding: 1.5rem;
            background-color: var(--paper);
            background-image:
                linear-gradient(rgba(16, 26, 51, 0.09) 1px, transparent 1px),
                linear-gradient(90deg, rgba(16, 26, 51, 0.09) 1px, transparent 1px),
                linear-gradient(rgba(16, 26, 51, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(16, 26, 51, 0.045) 1px, transparent 1px);
            background-size: 60px 60px, 60px 60px, 12px 12px, 12px 12px;
        }
        .product-img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; transition: transform 0.5s ease; }
        .product-card:hover .product-img { transform: scale(1.05); }

        .product-info-top {
            padding: 1.5rem;
            text-align: center;
            border-bottom: 1px solid var(--ink);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
        }
        .brand-tag {
            font-family: var(--f-mono);
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--vermilion);
            min-height: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.3s;
        }
        .product-name {
            font-family: var(--f-display);
            font-size: 1.35rem;
            font-weight: 420;
            font-variation-settings: "opsz" 48;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin: 0;
            line-height: 1.2;
            height: 4.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
        }
        .product-price { font-family: var(--f-mono); font-size: 1.6rem; font-weight: 500; letter-spacing: -0.03em; color: var(--ink); }
        .btn-small { padding: 0.75rem 1.25rem; font-size: 0.72rem; margin-top: 0.5rem; width: 100%; text-align: center; }

        /* Specs */
        .product-specs { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; flex-grow: 1; }
        .spec-row { display: flex; flex-direction: column; gap: 0.25rem; padding-bottom: 1rem; border-bottom: 1px dashed var(--rule-strong); }
        .spec-row:last-child { border-bottom: none; padding-bottom: 0; }
        .spec-label { font-family: var(--f-mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); font-weight: 500; }
        .spec-val { font-size: 1.05rem; color: var(--ink); font-weight: 500; }

        /* Tableau récapitulatif (rendu serveur) */
        .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        .compare-table-section { margin-top: 6rem; }
        .compare-table-title { font-size: clamp(2rem, 4vw, 3.4rem); margin: 0.9rem 0 2rem; }
        .compare-table-wrap { overflow-x: auto; border: 1px solid var(--ink); background: var(--surface); }
        .compare-table { width: 100%; border-collapse: collapse; min-width: 980px; font-size: 0.95rem; }
        .compare-table thead th {
            position: sticky; top: 0;
            background: var(--ink); color: var(--paper);
            font-family: var(--f-mono); font-size: 0.68rem; font-weight: 500;
            letter-spacing: 0.14em; text-transform: uppercase; text-align: left;
            padding: 0.9rem 1rem; white-space: nowrap;
        }
        .compare-table tbody th, .compare-table td { padding: 0.9rem 1rem; border-bottom: 1px dashed var(--rule-strong); text-align: left; vertical-align: top; }
        .compare-table tbody tr:last-child th, .compare-table tbody tr:last-child td { border-bottom: none; }
        .compare-table tbody tr:hover { background: var(--paper-2); }
        .compare-table tbody th { font-weight: 500; min-width: 240px; }
        .compare-table tbody th a {
            display: block; color: var(--ink); text-decoration: none;
            font-family: var(--f-display); font-size: 1.1rem; font-weight: 420; letter-spacing: -0.015em; line-height: 1.25;
        }
        .compare-table tbody th a:hover { color: var(--vermilion); }
        .compare-brand { display: block; margin-top: 0.25rem; font-family: var(--f-mono); font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--vermilion); }
        .compare-price { font-family: var(--f-mono); font-weight: 500; white-space: nowrap; }
    </style>

</Layout>
