---
// Liste de tous les articles d'une langue, optimisée SEO
import Layout from '../layouts/Layout.astro';
import { directusUrl, fetchPageSEO } from '../lib/directus';
import { listArticles } from '../lib/content';
import { useTranslations, localeMeta, path, pathInAllLocales, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const a = t.articles;
const intl = localeMeta[locale].intl;

let articles: any[] = [];
let errorMessage: string | null = null;

try {
    articles = await listArticles(locale, 'id,titre,slug,description_seo,date_publication,auteur,image_principale');
} catch (error: any) {
    console.error("Erreur Articles:", error);
    errorMessage = error.message;
}

const formatDate = (date: string) => {
    if (!date) return '';
    try {
        const d = new Date(date);
        if (isNaN(d.getTime())) return date;
        return new Intl.DateTimeFormat(intl, { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
    } catch (e) {
        return date;
    }
};
const abs = (p: string) => new URL(p, Astro.site).href;
const alternates = pathInAllLocales('articles');
const seo = { title: a.seoTitle, description: a.seoDescription };
---

<Layout locale={locale} alternates={alternates} title={seo.title} description={seo.description}>
    {articles.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "ItemList",
            "name": a.listName,
            "url": abs(path(locale, 'articles')),
            "numberOfItems": articles.length,
            "itemListElement": articles.map((item: any, i: number) => ({
                "@type": "ListItem",
                "position": i + 1,
                "url": abs(path(locale, 'articles', item.slug)),
                "name": item.titre
            }))
        })} is:inline />
    )}
    <div class="p-page p-page--wide">
        <!-- EN-TÊTE DE PAGE -->
        <header class="p-pagehead">
            <div class="p-crumb"><a href={path(locale, 'home')}>{t.nav.home}</a><span>/</span><span>{t.nav.articles}</span></div>
            <h1 class="p-display p-title" set:html={a.title}></h1>
            <p class="p-lede">{a.lede}</p>
        </header>

        <!-- GRILLE ARTICLES -->
        <div class="articles-content">
            {errorMessage ? (
                <div class="p-notice p-notice--error">
                    <strong>{a.error}</strong> {errorMessage}
                </div>
            ) : articles.length === 0 ? (
                <div class="p-notice">
                    <p>{a.empty}</p>
                </div>
            ) : (
                <div class="articles-grid">
                    {articles.map((article, i) => (
                        <article class:list={["article-card", { featured: i === 0 }]}>
                            {article.image_principale && (
                                <div class="card-img">
                                    <img
                                        src={`${directusUrl}/assets/${article.image_principale}?width=800&format=webp&quality=82`}
                                        alt={article.titre}
                                        loading={i === 0 ? 'eager' : 'lazy'}
                                        decoding="async"
                                        width="800"
                                        height="450"
                                    />
                                </div>
                            )}
                            <div class="card-body">
                                <div class="card-meta">
                                    {article.date_publication && (
                                        <time datetime={article.date_publication}>
                                            {formatDate(article.date_publication)}
                                        </time>
                                    )}
                                    {article.auteur && (
                                        <span class="author">{a.by} {article.auteur === 'Axel Paupier'
                                            ? <a href={path(locale, 'author', 'axel-paupier')} rel="author" class="author-link">{article.auteur}</a>
                                            : article.auteur}</span>
                                    )}
                                </div>
                                <h2><a href={path(locale, 'articles', article.slug)}>{article.titre}</a></h2>
                                {article.description_seo && (
                                    <p class="card-excerpt">{article.description_seo}</p>
                                )}
                                <a href={path(locale, 'articles', article.slug)} class="read-more">
                                    {a.read} <span>&rarr;</span>
                                </a>
                            </div>
                        </article>
                    ))}
                </div>
            )}
        </div>
    </div>
</Layout>

<style>
    .articles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
        gap: 2rem;
        counter-reset: art;
    }
    .article-card {
        position: relative;
        counter-increment: art;
        display: flex;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--ink);
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .article-card:hover {
        transform: translate(-4px, -4px);
        box-shadow: 8px 8px 0 var(--vermilion);
    }
    .article-card.featured {
        grid-column: 1 / -1;
        flex-direction: row;
    }
    .article-card.featured .card-img {
        flex: 0 0 52%;
        aspect-ratio: auto;
        min-height: 320px;
        border-bottom: none;
        border-right: 1px solid var(--ink);
    }
    .article-card.featured h2 { font-size: clamp(1.9rem, 3vw, 2.8rem); }

    .card-img {
        overflow: hidden;
        aspect-ratio: 16 / 9;
        border-bottom: 1px solid var(--ink);
        background-color: var(--paper-2);
    }
    .card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        mix-blend-mode: multiply;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .article-card:hover .card-img img { transform: scale(1.05); }

    .card-body {
        padding: 1.6rem 1.6rem 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        flex: 1;
    }
    .card-body::before {
        content: "N° " counter(art, decimal-leading-zero);
        font-family: var(--f-mono);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        color: var(--vermilion);
    }
    .card-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem 1rem;
        font-family: var(--f-mono);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
    }
    .author { text-transform: none; letter-spacing: 0.02em; }
    .card-body h2 {
        font-family: var(--f-display);
        font-size: 1.6rem;
        font-weight: 400;
        font-variation-settings: "opsz" 72;
        letter-spacing: -0.025em;
        line-height: 1.12;
    }
    .card-body h2 a { color: var(--ink); text-decoration: none; }
    .card-body h2 a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
    .author a { position: relative; z-index: 2; }
    .card-excerpt {
        color: var(--ink-soft);
        font-size: 1rem;
        line-height: 1.65;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .read-more {
        font-family: var(--f-mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: gap 0.2s, color 0.2s;
    }
    .article-card:hover .read-more { color: var(--vermilion); gap: 0.8rem; }

    @media (max-width: 760px) {
        .article-card.featured { flex-direction: column; }
        .article-card.featured .card-img {
            flex: none;
            aspect-ratio: 16 / 9;
            min-height: 0;
            border-right: none;
            border-bottom: 1px solid var(--ink);
        }
    }
</style>
