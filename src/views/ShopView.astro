---
import Layout from '../layouts/Layout.astro';
import { fetchPageSEO, directusUrl } from '../lib/directus';
import { listProducts } from '../lib/content';
import { normalizeCurrency, moneyHtml, convert, formatAmount } from '../lib/money';
import { getMoneyCtx } from '../lib/moneyCtx';
import { useTranslations, localeMeta, path, pathInAllLocales, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const s = t.shop;
const intl = localeMeta[locale].intl;
const money = await getMoneyCtx(locale);

let produits: any[] = [];
let errorMessage: string | null = null;

try {
    produits = await listProducts(locale, 'id,Nom_du_produit,prix,devise,descripton_simple,slug,image,marque,promo,prix_promo');
} catch (error: any) {
    errorMessage = error.message;
}

const marques = [...new Set(produits.map((p: any) => p.marque).filter(Boolean))].sort() as string[];

function parsePrice(val: any): number {
    if (!val) return 0;
    return parseFloat(String(val).replace(/[^\d.,]/g, '').replace(',', '.')) || 0;
}
// Prix de référence en euros (filtres et curseur), quelle que soit la monnaie du vendeur
const eurValue = (p: any): number => {
    const amount = parsePrice(p.prix);
    return amount > 0 ? convert(amount, normalizeCurrency(p.devise), 'EUR', money.rate) : 0;
};
const prices = produits.map(eurValue).filter((v: number) => v > 0);
const minPriceData = prices.length ? Math.floor(Math.min(...prices)) : 0;
const maxPriceData = prices.length ? Math.ceil(Math.max(...prices)) : 10000;
const hasPromo = produits.some((p: any) => p.promo && p.prix_promo);

const fmtEur = (n: number) => formatAmount(Math.round(convert(n, 'EUR', money.target, money.rate)), money.target, intl);
const countLabel = (n: number) => `${n} ${n !== 1 ? s.productMany : s.productOne}`;
const productHref = (p: any) => path(locale, 'product', p.slug || String(p.id));
const abs = (p: string) => new URL(p, Astro.site).href;
const alternates = pathInAllLocales('shop');

const seo =
    locale === 'fr'
        ? await fetchPageSEO('boutique', s.seoTitle, s.seoDescription)
        : { title: s.seoTitle, description: s.seoDescription };
---

<Layout locale={locale} alternates={alternates} title={seo.title} description={seo.description}>
    {produits.length > 0 && (
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "ItemList",
            "name": s.listName,
            "url": abs(path(locale, 'shop')),
            "numberOfItems": produits.length,
            "itemListElement": produits.map((p: any, i: number) => ({
                "@type": "ListItem",
                "position": i + 1,
                "url": abs(productHref(p)),
                "name": p.Nom_du_produit
            }))
        })} is:inline />
    )}

    <header class="shop-header">
        <div class="p-crumb"><a href={path(locale, 'home')}>{t.nav.home}</a><span>/</span><span>{t.nav.shop}</span></div>
        <h1 class="p-display p-title" set:html={s.title}></h1>
        <p class="p-lede">{s.lede}</p>
    </header>

    {errorMessage ? (
        <div class="shop-wrapper">
            <div class="p-notice p-notice--error">{errorMessage}</div>
        </div>
    ) : (
        <div class="shop-wrapper">
            <button class="sidebar-toggle" id="sidebarToggle" aria-label={s.openFilters}>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                {s.filters}
                <span class="filter-badge" id="filterBadge">0</span>
            </button>
            <div class="sidebar-overlay" id="sidebarOverlay"></div>

            <aside class="sidebar" id="sidebar" aria-label={s.filters}>
                <div class="sidebar-header">
                    <h2>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                        {s.filters}
                    </h2>
                    <button class="sidebar-close" id="sidebarClose" aria-label={s.close}>
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>

                <div class="filter-section">
                    <div class="search-wrap">
                        <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" id="searchInput" placeholder={s.search} autocomplete="off" />
                        <button class="search-clear" id="searchClear" aria-label={s.clear}>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>
                </div>

                {marques.length > 0 && (
                    <div class="filter-section accordion open">
                        <button class="accordion-toggle" aria-expanded="true">
                            <span>{s.brands}</span>
                            <span class="section-count">{marques.length}</span>
                            <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <div class="accordion-body">
                            <div class="accordion-inner">
                                {marques.map((marque) => (
                                    <label class="checkbox-label">
                                        <input type="checkbox" class="marque-filter" value={marque} />
                                        <span class="checkbox-custom"></span>
                                        <span class="label-text">{marque}</span>
                                    </label>
                                ))}
                            </div>
                        </div>
                    </div>
                )}

                {prices.length > 0 && (
                    <div class="filter-section accordion open">
                        <button class="accordion-toggle" aria-expanded="true">
                            <span>{s.price}</span>
                            <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <div class="accordion-body">
                            <div class="accordion-inner">
                                <div class="price-display">
                                    <span id="priceMinDisplay">{fmtEur(minPriceData)}</span>
                                    <span class="price-sep">—</span>
                                    <span id="priceMaxDisplay">{fmtEur(maxPriceData)}</span>
                                </div>
                                <div class="range-wrap">
                                    <input type="range" id="priceMin" class="range-input" min={minPriceData} max={maxPriceData} value={minPriceData} step="50" />
                                    <input type="range" id="priceMax" class="range-input" min={minPriceData} max={maxPriceData} value={maxPriceData} step="50" />
                                    <div class="range-track"><div class="range-fill" id="rangeFill"></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                )}

                {hasPromo && (
                    <div class="filter-section">
                        <label class="toggle-row">
                            <div class="toggle-info">
                                <span class="toggle-title">{s.promos}</span>
                                <span class="toggle-sub">{s.promosSub}</span>
                            </div>
                            <div class="toggle-wrap">
                                <input type="checkbox" id="promoOnly" class="toggle-input" />
                                <div class="toggle-track"><div class="toggle-thumb"></div></div>
                            </div>
                        </label>
                    </div>
                )}

                <div class="sidebar-footer">
                    <span class="results-count" id="sidebarCount">{countLabel(produits.length)}</span>
                    <button class="btn-reset" id="resetFilters">{s.reset}</button>
                </div>
            </aside>

            <div class="shop-main">
                <div class="products-toolbar">
                    <p class="toolbar-count" id="toolbarCount">{countLabel(produits.length)}</p>
                </div>
                <div class="grid" id="productsGrid">
                    {produits.map((p) => {
                        const isPromoValid = p.promo && p.prix_promo;
                        const price = (v: unknown) => moneyHtml(v, normalizeCurrency(p.devise), money);
                        const prixNum = Math.round(eurValue(p));
                        return (
                            <article class="card" data-nom={(p.Nom_du_produit || '').toLowerCase()} data-marque={p.marque || ''} data-prix={prixNum} data-promo={isPromoValid ? 'true' : 'false'}>
                                <a href={productHref(p)} class="card-img-link p-grid-paper" tabindex="-1" aria-hidden="true">
                                    {p.image ? (
                                        <img src={`${directusUrl}/assets/${p.image}?width=400&format=webp&quality=82`} alt={p.Nom_du_produit} loading="lazy" decoding="async" width="400" height="400" />
                                    ) : (
                                        <div class="img-placeholder p-label">{s.noImage}</div>
                                    )}
                                    {isPromoValid && <span class="p-stamp promo-badge">{s.sale}</span>}
                                </a>
                                <div class="card-body">
                                    <div class="card-tag">{p.marque || s.defaultTag}</div>
                                    <h3><a href={productHref(p)}>{p.Nom_du_produit}</a></h3>
                                    <p class="card-desc">{p.descripton_simple}</p>
                                    <div class="card-footer">
                                        {isPromoValid ? (
                                            <div class="price-wrapper">
                                                <span class="price old-price"><Fragment set:html={price(p.prix)} /></span>
                                                <span class="price promo-price"><Fragment set:html={price(p.prix_promo)} /></span>
                                            </div>
                                        ) : (
                                            <span class="price">{p.prix ? <Fragment set:html={price(p.prix)} /> : s.contact}</span>
                                        )}
                                        <a href={productHref(p)} class="btn">{s.view} &rarr;</a>
                                    </div>
                                </div>
                            </article>
                        );
                    })}
                </div>
                <div class="no-results" id="noResults" style="display:none">
                    <p>{s.noResults}</p>
                    <button class="btn btn-outline" id="noResultsReset">{s.resetFilters}</button>
                </div>
            </div>
        </div>
    )}

    <div id="shop-meta" data-min={minPriceData} data-max={maxPriceData} data-one={s.productOne} data-many={s.productMany} style="display:none" aria-hidden="true"></div>

    <script is:inline>
    (function () {
        var meta = document.getElementById('shop-meta');
        var minP = meta ? (parseInt(meta.dataset.min) || 0) : 0;
        var maxP = meta ? (parseInt(meta.dataset.max) || 10000) : 10000;
        var lblOne = meta ? meta.dataset.one : 'product';
        var lblMany = meta ? meta.dataset.many : 'products';

        var sidebar      = document.getElementById('sidebar');
        var overlay      = document.getElementById('sidebarOverlay');
        var toggleBtn    = document.getElementById('sidebarToggle');
        var closeBtn     = document.getElementById('sidebarClose');
        var filterBadge  = document.getElementById('filterBadge');
        var searchInput  = document.getElementById('searchInput');
        var searchClear  = document.getElementById('searchClear');
        var marqueBoxes  = document.querySelectorAll('.marque-filter');
        var priceMin     = document.getElementById('priceMin');
        var priceMax     = document.getElementById('priceMax');
        var priceMinDisp = document.getElementById('priceMinDisplay');
        var priceMaxDisp = document.getElementById('priceMaxDisplay');
        var rangeFill    = document.getElementById('rangeFill');
        var promoOnly    = document.getElementById('promoOnly');
        var sidebarCount = document.getElementById('sidebarCount');
        var toolbarCount = document.getElementById('toolbarCount');
        var noResults    = document.getElementById('noResults');
        var cards        = Array.from(document.querySelectorAll('#productsGrid .card'));
        var resetBtns    = document.querySelectorAll('#resetFilters, #noResultsReset');

        function openSidebar()  { if(sidebar) sidebar.classList.add('open'); if(overlay) overlay.classList.add('visible'); document.body.style.overflow='hidden'; }
        function closeSidebar() { if(sidebar) sidebar.classList.remove('open'); if(overlay) overlay.classList.remove('visible'); document.body.style.overflow=''; }
        if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
        if (closeBtn)  closeBtn.addEventListener('click', closeSidebar);
        if (overlay)   overlay.addEventListener('click', closeSidebar);

        document.querySelectorAll('.accordion-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var section = btn.closest('.accordion');
                var isOpen = section.classList.toggle('open');
                btn.setAttribute('aria-expanded', String(isOpen));
            });
        });

        function fmtPrice(n) {
            var c = window.nstCurrency;
            return c && c.formatEur ? c.formatEur(n) : n.toLocaleString('fr-FR') + ' €';
        }

        function updateRange() {
            if (!priceMin || !priceMax) return;
            var lo = parseInt(priceMin.value);
            var hi = parseInt(priceMax.value);
            if (lo > hi - 50) {
                if (document.activeElement === priceMin) { priceMin.value = hi - 50; lo = hi - 50; }
                else { priceMax.value = lo + 50; hi = lo + 50; }
            }
            if (priceMinDisp) priceMinDisp.textContent = fmtPrice(lo);
            if (priceMaxDisp) priceMaxDisp.textContent = fmtPrice(hi);
            var range = maxP - minP;
            if (rangeFill && range > 0) {
                rangeFill.style.left  = ((lo - minP) / range * 100) + '%';
                rangeFill.style.right = (100 - (hi - minP) / range * 100) + '%';
            }
            runFilter();
        }
        if (priceMin) priceMin.addEventListener('input', updateRange);
        if (priceMax) priceMax.addEventListener('input', updateRange);
        updateRange();
        document.addEventListener('nst:currency', updateRange);

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                if (searchClear) searchClear.style.opacity = searchInput.value ? '1' : '0';
                runFilter();
            });
        }
        if (searchClear) {
            searchClear.addEventListener('click', function() {
                if (searchInput) { searchInput.value = ''; searchInput.focus(); }
                searchClear.style.opacity = '0';
                runFilter();
            });
        }

        marqueBoxes.forEach(function(cb) { cb.addEventListener('change', runFilter); });
        if (promoOnly) promoOnly.addEventListener('change', runFilter);

        function matches(card) {
            var nom    = card.dataset.nom    || '';
            var marque = card.dataset.marque || '';
            var prix   = parseFloat(card.dataset.prix) || 0;
            var isPromo = card.dataset.promo === 'true';
            var q = searchInput ? searchInput.value.toLowerCase().trim() : '';
            if (q && !nom.includes(q) && !marque.toLowerCase().includes(q)) return false;
            var active = Array.from(marqueBoxes).filter(function(c){return c.checked;}).map(function(c){return c.value;});
            if (active.length && active.indexOf(marque) === -1) return false;
            if (priceMin && priceMax) {
                var lo = parseInt(priceMin.value), hi = parseInt(priceMax.value);
                if (prix > 0 && (prix < lo || prix > hi)) return false;
            }
            if (promoOnly && promoOnly.checked && !isPromo) return false;
            return true;
        }

        var filterTimer;
        function runFilter() {
            clearTimeout(filterTimer);
            filterTimer = setTimeout(function() {
                var visible = 0;
                cards.forEach(function(card, i) {
                    if (matches(card)) {
                        card.style.display = '';
                        (function(c,idx){ requestAnimationFrame(function(){ c.classList.remove('card-out'); c.style.transitionDelay=(idx%12*0.03)+'s'; }); })(card,i);
                        visible++;
                    } else {
                        card.classList.add('card-out');
                        card.style.transitionDelay = '0s';
                        clearTimeout(card._ht);
                        card._ht = setTimeout(function(){ if(card.classList.contains('card-out')) card.style.display='none'; }, 280);
                    }
                });
                var label = visible + ' ' + (visible !== 1 ? lblMany : lblOne);
                if (sidebarCount) sidebarCount.textContent = label;
                if (toolbarCount) toolbarCount.textContent = label;
                if (noResults) noResults.style.display = visible === 0 ? 'flex' : 'none';
                updateBadge();
            }, 60);
        }

        function updateBadge() {
            if (!filterBadge) return;
            var n = 0;
            if (searchInput && searchInput.value.trim()) n++;
            n += Array.from(marqueBoxes).filter(function(c){return c.checked;}).length;
            if (promoOnly && promoOnly.checked) n++;
            if (priceMin && parseInt(priceMin.value) > minP) n++;
            if (priceMax && parseInt(priceMax.value) < maxP) n++;
            filterBadge.textContent = n;
            filterBadge.classList.toggle('active', n > 0);
        }

        function resetAll() {
            if (searchInput) searchInput.value = '';
            if (searchClear) searchClear.style.opacity = '0';
            marqueBoxes.forEach(function(cb){ cb.checked = false; });
            if (promoOnly) promoOnly.checked = false;
            if (priceMin) priceMin.value = minP;
            if (priceMax) priceMax.value = maxP;
            updateRange();
            cards.forEach(function(card){ card.style.display=''; card.style.transitionDelay='0s'; card.classList.remove('card-out'); });
            var label = cards.length + ' ' + (cards.length !== 1 ? lblMany : lblOne);
            if (sidebarCount) sidebarCount.textContent = label;
            if (toolbarCount) toolbarCount.textContent = label;
            if (noResults) noResults.style.display = 'none';
            if (filterBadge) { filterBadge.textContent = '0'; filterBadge.classList.remove('active'); }
        }
        resetBtns.forEach(function(btn){ if(btn) btn.addEventListener('click', resetAll); });

        cards.forEach(function(card, i) {
            card.style.opacity = '0';
            card.style.transform = 'translateY(22px)';
            setTimeout(function() {
                card.style.transition = 'opacity 0.42s ease, transform 0.42s ease';
                card.style.opacity = '';
                card.style.transform = '';
                setTimeout(function(){ card.style.transition = ''; }, 450);
            }, 80 + i * 55);
        });
    })();
    </script>

</Layout>

<style>
.shop-header { max-width: 1600px; margin: 0 auto; width: 100%; padding: clamp(2.5rem, 5vw, 4.5rem) 2rem 0; box-sizing: border-box; }
.shop-header::after { content: ""; display: block; height: 1px; background: var(--ink); margin: 2.5rem 0 3rem; }

.shop-wrapper { display: flex; align-items: flex-start; gap: 2.5rem; padding: 0 2rem 6rem; max-width: 1600px; margin: 0 auto; width: 100%; box-sizing: border-box; }

/* Colonne de filtres */
.sidebar {
    width: 280px; flex-shrink: 0; position: sticky; top: 5.5rem; max-height: calc(100vh - 7rem); overflow-y: auto;
    background: var(--surface); border: 1px solid var(--ink); padding: 1.1rem 1.4rem 1.25rem;
    display: flex; flex-direction: column; scrollbar-width: thin; scrollbar-color: var(--ink) transparent;
}
.sidebar-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.9rem; border-bottom: 1px solid var(--ink); }
.sidebar-header h2 { display: flex; align-items: center; gap: 0.5rem; font-family: var(--f-mono); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink); margin: 0; }
.sidebar-close { display: none; background: none; border: 1px solid var(--ink); color: var(--ink); cursor: pointer; padding: 0.35rem; line-height: 0; transition: background 0.2s, color 0.2s; }
.sidebar-close:hover { background: var(--ink); color: var(--paper); }

.filter-section { border-bottom: 1px dashed var(--rule-strong); padding: 1rem 0; }
.filter-section:last-child { border-bottom: none; }

.search-wrap { position: relative; }
.search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--ink-soft); pointer-events: none; }
.search-wrap input { width: 100%; background: var(--paper); border: 1px solid var(--ink); border-radius: 0; padding: 0.65rem 2rem 0.65rem 2.2rem; color: var(--ink); font-size: 0.9rem; outline: none; font-family: var(--f-body); transition: box-shadow 0.2s, background 0.2s; }
.search-wrap input::placeholder { color: #8a90a4; }
.search-wrap input:focus { background: #fff; box-shadow: 3px 3px 0 var(--vermilion); }
.search-clear { position: absolute; right: 0.6rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--ink-soft); cursor: pointer; padding: 0.2rem; line-height: 0; opacity: 0; transition: opacity 0.2s, color 0.2s; }
.search-clear:hover { color: var(--vermilion); }

.accordion-toggle { width: 100%; display: flex; align-items: center; gap: 0.5rem; background: none; border: none; cursor: pointer; color: var(--ink); font-family: var(--f-mono); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; padding: 0; text-align: left; transition: color 0.2s; }
.accordion-toggle:hover { color: var(--vermilion); }
.accordion-toggle > span:first-child { flex: 1; }
.section-count { font-size: 0.66rem; font-weight: 600; color: var(--paper); background: var(--ink); padding: 0.1rem 0.45rem; }
.chevron { color: var(--ink); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); flex-shrink: 0; }
.accordion.open .chevron { transform: rotate(180deg); }
.accordion-body { overflow: hidden; max-height: 0; opacity: 0; transition: max-height 0.38s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease; }
.accordion.open .accordion-body { max-height: 500px; opacity: 1; }
.accordion-inner { padding-top: 0.85rem; display: flex; flex-direction: column; gap: 0.1rem; }

.checkbox-label { display: flex; align-items: center; gap: 0.7rem; cursor: pointer; padding: 0.4rem 0.4rem; transition: background 0.15s, padding 0.2s; font-size: 0.92rem; color: var(--ink-soft); }
.checkbox-label:hover { background: rgba(16, 26, 51, 0.06); color: var(--ink); padding-left: 0.65rem; }
.checkbox-label input { display: none; }
.checkbox-custom { width: 16px; height: 16px; flex-shrink: 0; border: 1.5px solid var(--ink); background: transparent; transition: background 0.2s; position: relative; display: flex; align-items: center; justify-content: center; }
.checkbox-label input:checked + .checkbox-custom { background: var(--ink); }
.checkbox-label input:checked + .checkbox-custom::after { content: ''; width: 8px; height: 4px; border-left: 2px solid var(--paper); border-bottom: 2px solid var(--paper); transform: rotate(-45deg) translateY(-1px); display: block; }
.checkbox-label input:checked ~ .label-text { color: var(--ink); font-weight: 600; }

.price-display { display: flex; align-items: center; gap: 0.5rem; font-family: var(--f-mono); font-size: 0.85rem; font-weight: 500; color: var(--ink); margin-bottom: 1rem; }
.price-sep { color: var(--ink-soft); }
.range-wrap { position: relative; height: 32px; display: flex; align-items: center; }
.range-track { position: absolute; left: 0; right: 0; height: 2px; background: var(--rule); pointer-events: none; }
.range-fill { position: absolute; top: -1px; bottom: -1px; background: var(--vermilion); transition: left 0.05s, right 0.05s; }
.range-input { position: absolute; width: 100%; height: 4px; appearance: none; background: transparent; pointer-events: none; outline: none; }
.range-input::-webkit-slider-thumb { appearance: none; width: 16px; height: 16px; border-radius: 0; background: var(--ink); border: 2px solid var(--paper); box-shadow: 0 0 0 1px var(--ink); cursor: pointer; pointer-events: all; transition: transform 0.18s, background 0.18s; }
.range-input::-webkit-slider-thumb:hover, .range-input::-webkit-slider-thumb:active { transform: scale(1.2); background: var(--vermilion); }
.range-input::-moz-range-thumb { width: 12px; height: 12px; border-radius: 0; background: var(--ink); border: 2px solid var(--paper); box-shadow: 0 0 0 1px var(--ink); cursor: pointer; pointer-events: all; }

.toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; cursor: pointer; }
.toggle-info { flex: 1; }
.toggle-title { display: block; font-family: var(--f-mono); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); }
