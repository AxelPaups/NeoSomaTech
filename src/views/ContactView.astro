---
import Layout from '../layouts/Layout.astro';
import { fetchPageSEO } from '../lib/directus';
import { useTranslations, path, pathInAllLocales, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = t.contact;
const alternates = pathInAllLocales('contact');
const seo =
    locale === 'fr'
        ? await fetchPageSEO('contact', c.seoTitle, c.seoDescription)
        : { title: c.seoTitle, description: c.seoDescription };
---

<Layout locale={locale} alternates={alternates} title={seo.title} description={seo.description}>
    <div class="p-page p-page--form">
        <div class="p-crumb"><a href={path(locale, 'home')}>{t.nav.home}</a><span>/</span><span>{t.nav.contact}</span></div>
        <h1 class="p-display p-title" set:html={c.title}></h1>
        <p class="intro p-lede">{c.lede}</p>

        <div class="contact-grid">
            <div class="contact-info">
                <div class="info-block">
                    <span class="icon">01</span>
                    <div>
                        <strong>{c.infoEmail}</strong>
                        <p>neosomatech@gmail.com</p>
                    </div>
                </div>
                <div class="info-block">
                    <span class="icon">02</span>
                    <div>
                        <strong>{c.infoAvail}</strong>
                        <p>{c.availValue}</p>
                    </div>
                </div>
                <div class="info-block">
                    <span class="icon">03</span>
                    <div>
                        <strong>{c.infoDelay}</strong>
                        <p>{c.delayValue}</p>
                    </div>
                </div>
            </div>

            <form class="contact-form" id="contactForm">
                <script type="application/json" id="contact-i18n" set:html={JSON.stringify(c)}></script>
                <div class="form-group">
                    <label for="name">{c.name}</label>
                    <input id="name" name="name" type="text" placeholder={c.namePh} required />
                </div>
                <div class="form-group">
                    <label for="email">{c.email}</label>
                    <input id="email" name="email" type="email" placeholder={c.emailPh} required />
                </div>
                <div class="form-group">
                    <label for="tel">{c.phone}</label>
                    <input id="tel" name="tel" type="tel" placeholder={c.phonePh} />
                </div>
                <div class="form-group">
                    <label for="message">{c.message}</label>
                    <textarea id="message" name="message" rows="5" placeholder={c.messagePh} required></textarea>
                </div>

                <div class="form-group checkbox-group">
                    <input id="rgpd" name="rgpd" type="checkbox" required />
                    <label for="rgpd" set:html={c.consent}></label>
                </div>

                <button type="submit" class="btn" id="submitBtn">{c.submit}</button>
                <div id="statusMessage" class="status-message"></div>
            </form>
        </div>
    </div>
</Layout>

<script>
    // Textes fournis par le serveur dans la langue de la page (repli : français)
    let i18n: Record<string, string> = {};
    try {
        i18n = JSON.parse(document.getElementById('contact-i18n')?.textContent || '{}');
    } catch {
        i18n = {};
    }
    const tr = (key: string, fallback: string) => i18n[key] ?? fallback;

    const form = document.querySelector('#contactForm') as HTMLFormElement;
    const statusDiv = document.querySelector('#statusMessage') as HTMLDivElement;
    const submitBtn = document.querySelector('#submitBtn') as HTMLButtonElement;

    // Réinitialise le message d'état quand l'utilisateur tape à nouveau
    form?.querySelectorAll('input, textarea, checkbox').forEach(input => {
        input.addEventListener('input', () => {
            statusDiv.style.display = 'none';
            statusDiv.className = 'status-message';
        });
    });

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Reset UI
        statusDiv.textContent = tr('loading', 'Chargement de votre message...');
        statusDiv.className = 'status-message info show';
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';
        submitBtn.textContent = tr('sending', 'Envoi en cours...');

        // Extraction des données du formulaire
        const formData = new FormData(form);
        const payload = {
            nom: formData.get('name'),
            email: formData.get('email'),
            telephone: formData.get('tel'),
            message: formData.get('message'),
            rgpd: (formData.get('rgpd') === 'on' || formData.get('rgpd') === 'true')
        };

        try {
            const response = await fetch('/api/contact', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload),
            });

            const result = await response.json().catch(() => ({ message: 'Erreur de lecture de la réponse serveur.' }));

            if (response.ok) {
                statusDiv.textContent = tr('sent', 'Message envoyé !');
                statusDiv.className = 'status-message success show';
                form.reset();
                submitBtn.textContent = tr('sentBtn', 'Message Envoyé ✓');
                setTimeout(() => {
                    submitBtn.textContent = tr('another', 'Envoyer un autre message →');
                    submitBtn.style.opacity = '1';
                    submitBtn.disabled = false;
                }, 4000);
            } else {
                statusDiv.textContent = (result.code === 'missing_fields' ? tr('missing', result.message) : null) || tr('errorSend', result.message || 'Une erreur est survenue lors de l’envoi.');
                statusDiv.className = 'status-message error show';
                submitBtn.disabled = false;
                submitBtn.style.opacity = '1';
                submitBtn.textContent = tr('retry', 'Réessayer l\'envoi →');
            }
        } catch (error: any) {
            console.error('Fetch error:', error);
            statusDiv.textContent = tr('network', 'Erreur réseau ou crash du serveur. Consultez la console.');
            statusDiv.className = 'status-message error show';
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitBtn.textContent = tr('retry', 'Réessayer l\'envoi →');
        }
    });
</script>

<style>
    .intro { margin-bottom: 3.5rem; }
    .contact-grid { display: grid; grid-template-columns: 1fr 1.7fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }

    .contact-info { display: flex; flex-direction: column; border-top: 1px solid var(--ink); }
    .info-block {
        display: grid;
        grid-template-columns: 2.5rem 1fr;
        gap: 0.75rem;
        padding: 1.4rem 0;
        border-bottom: 1px solid var(--ink);
        transition: padding 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .info-block:hover { padding-left: 0.75rem; }
    .icon {
        font-family: var(--f-mono);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--vermilion);
        padding-top: 0.15rem;
    }
    .info-block strong {
        display: block;
        margin-bottom: 0.3rem;
        font-family: var(--f-display);
        font-size: 1.25rem;
        font-weight: 420;
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .info-block p { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; }

    .contact-form { display: flex; flex-direction: column; gap: 1.4rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .form-group label {
        font-family: var(--f-mono);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
    }
    .form-group input,
    .form-group textarea {
        background: var(--surface);
        border: 1px solid var(--ink);
        border-radius: 0;
        color: var(--ink);
        font-family: var(--f-body);
        font-size: 1rem;
        padding: 0.85rem 1rem;
        outline: none;
        resize: vertical;
        transition: box-shadow 0.2s, background 0.2s;
    }
    .form-group input:focus,
    .form-group textarea:focus {
        background: #fff;
        box-shadow: 4px 4px 0 var(--vermilion);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: #8a90a4; }

    .checkbox-group { flex-direction: row !important; align-items: flex-start; gap: 0.85rem !important; margin-top: 0.25rem; }
    .checkbox-group input { width: 18px; height: 18px; margin-top: 0.2rem; flex: none; accent-color: var(--ink); }
    .checkbox-group label {
        font-family: var(--f-body) !important;
        font-size: 0.85rem !important;
        letter-spacing: 0 !important;
        text-transform: none !important;
        line-height: 1.5;
        color: var(--ink-soft) !important;
        font-weight: 400 !important;
    }
    .checkbox-group label a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
    .checkbox-group label a:hover { color: var(--vermilion); }

    .contact-form .btn { align-self: flex-start; }

    .status-message {
        margin-top: 0.5rem;
        padding: 1.1rem 1.25rem;
        font-size: 0.95rem;
        line-height: 1.5;
        display: none;
        border: 1px solid var(--ink);
        animation: fadeIn 0.3s ease-out;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .status-message.show { display: block; }
    .status-message.success { border-color: #2f6b3f; background: rgba(47, 107, 63, 0.08); color: #24552f; }
    .status-message.error { border-color: var(--vermilion); background: rgba(232, 57, 29, 0.08); color: #b02a12; }
    .status-message.info { border-color: var(--blueprint); background: rgba(42, 79, 160, 0.07); color: var(--blueprint); }

    @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
