---
import Layout from "../layouts/Layout.astro";
import { useTranslations, path, type Locale } from "../i18n";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const n = useTranslations(locale).notFound;
---

<Layout locale={locale} title={n.seoTitle} description={n.seoDescription}>
	<section class="error-page p-grid-paper">
		<div class="container error-content">
			<p class="p-label error-badge"><b>{n.badgePlate}</b> &mdash; {n.badgeSub}</p>
			<div class="error-visual">
				<h1 class="error-code p-display" aria-label="Erreur 404">404</h1>
				<div class="error-icon">
					<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bot-off"><path d="M12 8V4H8"/><rect width="18" height="12" x="3" y="8" rx="2"/><path d="m2 2 20 20"/><path d="M9 13h.01"/><path d="M15 13h.01"/><path d="M12 16v2"/><path d="M14 8h1a2 2 0 0 0 2-2V4"/></svg>
				</div>
			</div>
			<h2 class="error-title p-display">
				<Fragment set:html={n.title} />
			</h2>
			<p class="error-message">{n.message}</p>
			<div class="error-actions">
				<a href={path(locale, 'home')} class="btn">{n.home} &rarr;</a>
				<a href={path(locale, 'shop')} class="btn btn-outline">{n.shop}</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.error-page {
		position: relative;
		min-height: calc(100vh - 220px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 5rem 0;
		text-align: center;
		border-bottom: 1px solid var(--ink);
	}
	.error-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}
	.error-visual {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.error-code {
		font-size: clamp(8rem, 26vw, 20rem);
		font-weight: 200;
		line-height: 0.9;
		letter-spacing: -0.06em;
		color: transparent;
		-webkit-text-stroke: 1.5px var(--ink);
		user-select: none;
	}
	.error-icon {
		position: absolute;
		color: var(--vermilion);
		background: var(--paper);
		border: 1px solid var(--ink);
		padding: 1rem;
		box-shadow: 6px 6px 0 var(--ink);
	}
	.error-title {
		font-size: clamp(2rem, 5vw, 3.75rem);
	}
	.error-message {
		font-size: 1.1rem;
		color: var(--ink-soft);
		max-width: 56ch;
		line-height: 1.7;
	}
	.error-actions {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 0.75rem;
	}
	@media (max-width: 768px) {
		.error-page { padding: 3.5rem 1rem; }
	}
</style>
