---
// Conseiller exosquelette : quiz en 4 questions qui recommande des produits du catalogue.
// La logique de classement vit dans lib/advisor.ts (import côté serveur ET côté client, via
// scripts/advisor.client.ts) pour n'avoir qu'une seule source de vérité sur les règles.
import Layout from '../layouts/Layout.astro';
import { directusUrl, fetchPageSEO } from '../lib/directus';
import { listProducts } from '../lib/content';
import { normalizeCurrency, parseAmount, convert } from '../lib/money';
import { getMoneyCtx } from '../lib/moneyCtx';
import { getProductTags } from '../lib/advisor';
import { useTranslations, path, pathInAllLocales, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const a = t.advisor;
const money = await getMoneyCtx(locale);

const ADVISOR_FIELDS =
	'id,Nom_du_produit,nom_court,slug,marque,prix,devise,image,descripton_simple,promo,prix_promo,advisor_usages,advisor_zones,advisor_type';

let products: any[] = [];
let errorMessage: string | null = null;
try {
	products = await listProducts(locale, ADVISOR_FIELDS, { limit: -1 });
} catch (error: any) {
	errorMessage = error.message;
}

// Prix en euros (pour le tri par budget), quelle que soit la devise d'origine du produit.
const priceEurOf = (p: any): number | null => {
	const raw = parseAmount(p.prix_promo && p.promo ? p.prix_promo : p.prix);
	if (raw == null) return null;
	const devise = normalizeCurrency(p.devise);
	return devise === 'EUR' ? raw : convert(raw, 'USD', 'EUR', money.rate);
};

const productsForClient = products
	.filter((p) => p.slug)
	.map((p) => {
		const tags = getProductTags(p);
		return {
			id: p.id,
			nom: p.Nom_du_produit,
			nomCourt: p.nom_court || p.Nom_du_produit,
			slug: p.slug,
			marque: p.marque || '',
			desc: p.descripton_simple || '',
			image: p.image ? `${directusUrl}/assets/${p.image}?width=400&format=webp&quality=82` : null,
			prix: p.prix ?? null,
			devise: normalizeCurrency(p.devise),
			priceEur: priceEurOf(p),
			usages: tags.usages,
			zones: tags.zones,
			type: tags.type,
			href: path(locale, 'product', p.slug),
		};
	});

const alternates = pathInAllLocales('advisor');
const seo =
	locale === 'fr'
		? await fetchPageSEO('conseiller', a.seoTitle, a.seoDescription)
		: { title: a.seoTitle, description: a.seoDescription };

const shopHref = path(locale, 'shop');
---

<Layout locale={locale} alternates={alternates} title={seo.title} description={seo.description}>
	<div class="p-page">
		<header class="p-pagehead">
			<div class="p-crumb"><a href={path(locale, 'home')}>{t.nav.home}</a><span>/</span><span>{t.nav.advisor}</span></div>
			<h1 class="p-display p-title" set:html={a.title}></h1>
			<p class="p-lede">{a.lede}</p>
		</header>

		{errorMessage ? (
			<div class="p-notice p-notice--error">{errorMessage}</div>
		) : (
			<div id="advisor-app" class="advisor-app" data-shop-href={shopHref}>
				<script type="application/json" id="advisor-data" set:html={JSON.stringify(productsForClient)}></script>
				<script type="application/json" id="advisor-i18n" set:html={JSON.stringify(a)}></script>

				<div class="advisor-step-indicator" id="advisor-step-indicator" aria-hidden="true">
					<span class="step-dot" data-step="1"></span>
					<span class="step-dot" data-step="2"></span>
					<span class="step-dot" data-step="3"></span>
					<span class="step-dot" data-step="4"></span>
				</div>
				<p class="p-label advisor-step-label" id="advisor-step-label"></p>

				<div id="advisor-quiz" class="advisor-quiz"></div>
				<div id="advisor-results" class="advisor-results" hidden></div>
			</div>
		)}
	</div>
</Layout>

<script src="../scripts/advisor.client.ts"></script>

<style>
	.advisor-app { max-width: 860px; margin: 0 auto; }

	.advisor-step-indicator { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
	.step-dot { width: 2.2rem; height: 3px; background: var(--rule); }
	.step-dot.is-active, .step-dot.is-done { background: var(--vermilion); }
	.advisor-step-label { margin-bottom: 2rem; }

	.advisor-question h2 {
		font-family: var(--f-display);
		font-size: clamp(1.5rem, 3vw, 2.1rem);
		font-weight: 420;
		font-variation-settings: "opsz" 48;
		letter-spacing: -0.02em;
		margin-bottom: 0.5rem;
	}
	.advisor-question .hint { color: var(--ink-soft); font-size: 0.9rem; margin-bottom: 1.5rem; }

	.advisor-options { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 0.9rem; margin-bottom: 2rem; }
	.advisor-opt {
		text-align: left;
		background: var(--surface);
		border: 1px solid var(--ink);
		padding: 1rem 1.1rem;
		cursor: pointer;
		font-family: var(--f-body);
		font-size: 1rem;
		color: var(--ink);
		transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
	}
	.advisor-opt:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--vermilion); }
	.advisor-opt.is-selected { background: var(--ink); color: var(--paper); }
	.advisor-opt .opt-help { display: block; font-size: 0.82rem; color: var(--ink-soft); margin-top: 0.35rem; font-weight: 400; }
	.advisor-opt.is-selected .opt-help { color: rgba(255,255,255,0.7); }

	.advisor-nav { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1rem; }
	.advisor-skip { font-family: var(--f-mono); font-size: 0.78rem; letter-spacing: 0.06em; color: var(--ink-soft); background: none; border: none; cursor: pointer; text-decoration: underline; }
	.advisor-skip:hover { color: var(--vermilion); }

	.advisor-results h2 { font-family: var(--f-display); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 420; margin-bottom: 0.3rem; }
	.advisor-results .subtitle { color: var(--ink-soft); margin-bottom: 2rem; }
	.advisor-results-grid { display: grid; gap: 1.5rem; margin-bottom: 2rem; }
	.advisor-result-card {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 1.4rem;
		background: var(--surface);
		border: 1px solid var(--ink);
		padding: 1.4rem;
	}
	.advisor-result-img { aspect-ratio: 1; overflow: hidden; background: var(--paper-2); display: flex; align-items: center; justify-content: center; }
	.advisor-result-img img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
	.advisor-result-body h3 { font-family: var(--f-display); font-size: 1.3rem; font-weight: 420; margin-bottom: 0.3rem; }
	.advisor-result-body h3 a { color: var(--ink); text-decoration: none; }
	.advisor-result-brand { font-family: var(--f-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--vermilion); }
	.advisor-result-price { font-family: var(--f-mono); font-size: 1.1rem; margin: 0.4rem 0; }
	.advisor-result-why { font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5; margin: 0.5rem 0; }
	.advisor-result-link { font-family: var(--f-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); }
	.advisor-empty { padding: 2rem; border: 1px dashed var(--rule-strong); text-align: center; color: var(--ink-soft); }

	@media (max-width: 560px) {
		.advisor-result-card { grid-template-columns: 1fr; }
	}
</style>
