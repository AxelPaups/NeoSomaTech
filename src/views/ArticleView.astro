---
import Layout from '../layouts/Layout.astro';
import { directusUrl } from '../lib/directus';
import { linkifyProducts } from '../lib/linkifyProducts';
import { useTranslations, localeMeta, path, type Locale } from '../i18n';

interface Props {
    locale: Locale;
    article: any;
    productsForLinking: { name: string; slug: string }[];
    faqs?: { question: string; reponse: string }[];
    errorMessage: string | null;
    alternates: Partial<Record<Locale, string>>;
}

const { locale, article, productsForLinking, faqs = [], errorMessage, alternates } = Astro.props;
const t = useTranslations(locale);
const a = t.articles;
const intl = localeMeta[locale].intl;

// Liens automatiques vers les fiches produit de la langue
const linkifiedContent = article?.contenu
    ? linkifyProducts(article.contenu, productsForLinking, { productBase: path(locale, 'product'), titlePrefix: a.viewProduct })
    : '';

const imageUrl = article?.image_principale ? `${directusUrl}/assets/${article.image_principale}` : null;

const formatDate = (date: string) => {
    if (!date) return '';
    try {
        const d = new Date(date);
        if (isNaN(d.getTime())) return date;
        return new Intl.DateTimeFormat(intl, { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
    } catch (e) {
        return date;
    }
};
---

<Layout
    locale={locale}
    alternates={alternates}
    title={article ? `${article.titre} | NeoSomaTech` : a.notFoundTitle}
    description={article?.meta_description || article?.description_seo || a.defaultDescription}
    image={imageUrl || '/favicon.png'}
    type="article"
    schemaItem={article}
    faqs={faqs}
    noindex={!article || !!errorMessage}
>

    {errorMessage ? (
        <div class="container p-notice p-notice--error error-box">
            <strong>{a.error}</strong> {errorMessage}
        </div>
    ) : article && (
        <article class="article-wrapper">
            <!-- HERO IMAGE -->
            {imageUrl && (
                <div class="article-hero">
                    <img src={`${imageUrl}?width=1200&format=webp&quality=82`} alt={article.titre} loading="eager" fetchpriority="high" decoding="async" />
                </div>
            )}

            <div class="article-body container">
                <!-- BREADCRUMB -->
                <nav class="p-crumb">
                    <a href={path(locale, 'home')}>{t.nav.home}</a><span>/</span>
                    <a href={path(locale, 'articles')}>{t.nav.articles}</a><span>/</span>
                    <span>{article.titre}</span>
                </nav>

                <!-- META -->
                <div class="article-meta p-label">
                    {article.date_publication && (
                        <time datetime={article.date_publication}>
                            {formatDate(article.date_publication)}
                        </time>
                    )}
                    {article.auteur && (
                        <span>{a.byPrefix} {article.auteur === 'Axel Paupier'
                            ? <a href={path(locale, 'author', 'axel-paupier')} rel="author" class="author-link">{article.auteur}</a>
                            : article.auteur}</span>
                    )}
                </div>

                <!-- TITRE -->
                <h1 class="p-display">{article.titre}</h1>

                <!-- RÉSUMÉ SEO -->
                {article.description_seo && (
                    <p class="article-lead">{article.description_seo}</p>
                )}

                <!-- CONTENU HTML -->
                {linkifiedContent && (
                    <div class="article-content p-prose" set:html={linkifiedContent} />
                )}

                <!-- FOOTER ARTICLE -->
                <div class="article-footer">
                    <a href={path(locale, 'articles')} class="btn btn-outline">&larr; {a.back}</a>
                </div>
            </div>
        </article>
    )}
</Layout>

<style>
    .article-hero {
        width: 100%;
        overflow: hidden;
        border-bottom: 1px solid var(--ink);
        background: var(--paper-2);
    }
    .article-hero img {
        display: block;
        width: 100%;
        height: clamp(240px, 40vw, 520px);
        object-fit: cover;
    }

    .article-body {
        max-width: 820px;
        padding-top: 3rem;
        padding-bottom: 6rem;
    }
    .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-bottom: 1.25rem;
    }
    .article-meta :global(.author-link) { font-weight: 600; }
    h1 {
        font-size: clamp(2.2rem, 5.4vw, 4rem);
        line-height: 1.04;
        margin-bottom: 1.75rem;
    }
    .article-lead {
        font-family: var(--f-display);
        font-style: italic;
        font-weight: 350;
        font-variation-settings: "opsz" 48;
        font-size: clamp(1.25rem, 2.2vw, 1.55rem);
        line-height: 1.55;
        color: var(--ink-soft);
        margin-bottom: 2.75rem;
        padding-bottom: 2.25rem;
        border-bottom: 1px solid var(--ink);
    }
    .article-content { font-size: 1.1rem; }

    .article-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--ink);
    }
    .error-box { max-width: 640px; margin: 4rem auto; }
</style>
