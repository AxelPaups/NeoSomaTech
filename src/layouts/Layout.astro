---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/PostHog.astro';
import Schema from '../components/Schema.astro';
import Ruler from '../components/Ruler.astro';
import '../styles/planche.css';
import { getMoneyCtx } from '../lib/moneyCtx';
import { localeFromPath, localeMeta, useTranslations, type Locale } from '../i18n';

interface Props {
	/** Langue de la page (par défaut : déduite de l'URL) */
	locale?: Locale;
	/** Adresse de cette page dans chaque langue où elle existe (sert au sélecteur de langue et aux balises hreflang) */
	alternates?: Partial<Record<Locale, string>>;
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article' | 'product' | 'page';
	schemaItem?: any;
	faqs?: any[];
	aggregateRating?: { ratingValue: number; reviewCount: number };
	noindex?: boolean;
}

const {
	locale: localeProp,
	alternates,
	title,
	description: descriptionProp,
	image = '/og-image.png',
	type = 'website',
	schemaItem,
	faqs,
	aggregateRating,
	noindex = false
} = Astro.props;

const locale: Locale = localeProp ?? localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const meta = localeMeta[locale];
const description = descriptionProp ?? t.site.defaultDescription;
const money = await getMoneyCtx(locale);

// Adresse de chaque langue : celles déclarées par la page, sinon la page seule
const pages: Partial<Record<Locale, string>> = alternates ?? { [locale]: Astro.url.pathname };
const abs = (p: string) => new URL(p, Astro.site);
const canonicalURL = abs(pages[locale] ?? Astro.url.pathname);
const otherLocales = (Object.keys(pages) as Locale[]).filter((l) => l !== locale);
const xDefault = pages.fr ?? pages[locale];
const fontsUrl = 'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..500;1,9..144,300..500&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap';
---

<!doctype html>
<html
	lang={meta.hreflang}
	data-fx-rate={money.rate}
	data-fx-date={money.date}
	data-default-currency={money.target}
	data-seller-label={t.money.seller}
	data-converted-note={t.money.converted}
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="shortcut icon" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href={fontsUrl} />
		<link href={fontsUrl} rel="stylesheet" media="print" onload="this.media='all'" />
		<noscript><link href={fontsUrl} rel="stylesheet" /></noscript>

		<!-- SEO Primordial -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
		<link rel="canonical" href={canonicalURL} />
		{(Object.entries(pages) as [Locale, string][]).map(([l, p]) => <link rel="alternate" hreflang={localeMeta[l].hreflang} href={abs(p)} />)}
		{xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
		{locale === 'fr' && <link rel="alternate" type="application/rss+xml" title={t.site.feedTitle} href="/rss.xml" />}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:locale" content={meta.ogLocale} />
		{otherLocales.map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />
		
		<!-- PostHog Analytics -->
		<PostHog />

		<!-- Structured Data -->
		<Schema type={type} item={schemaItem} faqs={faqs} aggregateRating={aggregateRating} locale={locale} />
	</head>
	<body id="top" data-theme="planche">
		<Ruler />
		<Header locale={locale} alternates={pages} />
		<main>
			<slot />
		</main>
		<Footer locale={locale} />
		<script>
			import '../scripts/currency.client.ts';
		</script>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		max-width: 100vw;
		overflow-x: hidden;
	}
	main {
		flex: 1;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		width: 100%;
	}

	/* Lien de signature auteur (byline) : soulignement animé au survol */
	.author-link {
		text-decoration: none;
		font-weight: 600;
		position: relative;
		transition: color 0.2s ease;
	}
	.author-link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -2px;
		width: 100%;
		height: 1.5px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}
	.author-link:hover::after {
		transform: scaleX(1);
	}

	@media (max-width: 768px) {
		html {
			font-size: 15px;
		}
		.container {
			padding: 0 1rem;
		}
	}
</style>
